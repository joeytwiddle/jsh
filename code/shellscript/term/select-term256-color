#!/usr/bin/env python3
"""select-term256-color: interactive xterm-256 / hex colour picker.

Three modes (Tab cycles hsv -> truecolor -> swatch):

  hsv        DEFAULT. SV plane + hue ramp, painted with the nearest xterm-256
             cells (visible banding). Output is the quantised "colourNNN".
  truecolor  Same SV plane geometry but each cell is overpainted with a 24-bit
             ANSI escape, so the gradient is smooth on truecolor terminals.
             Output is the exact "#rrggbb". Falls back to hsv-style banding on
             non-truecolor terminals.
  swatch     The full 256 xterm colours laid out as in xterm-color-list.sh.
             Output is "colourNNN". The only place to reach system colours
             0-15.

Keys:
  arrows / hjkl / wasd   move
  0-9                    (swatch mode) type a colour index
  , . / q e              (hsv mode) shift hue
  Tab                    toggle swatch / hsv mode
  #                      enter hex mode; type 3 or 6 hex digits then Enter
  Enter / Space          accept
  q / Esc                cancel  (q quits in swatch mode; in hsv mode q is hue)

Output (on accept):
  swatch, hsv  -> "colourNNN"
  truecolor    -> "#rrggbb"
  # hex entry  -> "#rrggbb"
Exit code: 0 on accept, 1 on cancel, 2 on setup error.
"""

import argparse
import curses
import os
import re
import shlex
import subprocess
import sys


GAP = None  ## visual gap between sections of the swatch layout
CELL_W = 5  ## " NNN " cell width in swatch mode
CUBE_VALUES = (0, 95, 135, 175, 215, 255)

HSV_CELL_W = 2       ## chars per cell in HSV / truecolor planes
HSV_PLANE_INDENT = 1 ## screen-column indent for the SV plane and its label row
HUE_LABEL = " Hue:"  ## odd-length matches the 2-char cell stride so cells line up vertically
HSV_PLANE_STRETCH_CELLS = 2  ## extra plane cells beyond hue_steps so plane right edge aligns
                             ## with hue right edge: indent + 2*w = len(HUE_LABEL) + 2*hue_steps

## Layout overhead used by auto_plane_size and the HSV pad sizer.
## Rows: title + blank + hue + label + blank-below-plane + status + help + cursor row = 8.
## If this is < 8, auto_h ends up 1 row taller than what's actually visible,
## and vertical cursor moves shift plane_scroll_y → the truecolor diff finds
## hundreds of changed cells → the whole plane visibly repaints. Keep it at 8.
HSV_OVERHEAD_ROWS = 8
HSV_OVERHEAD_COLS = 7  ## 5-char left label + 2-char right margin

## Screen-row positions for the HSV / truecolor layout — referenced by
## compute_truecolor_cells (module-level) so they must live up here too.
HUE_SCREEN_Y = 2
LABEL_SCREEN_Y = 3
PLANE_SCREEN_TOP = 4

## Plane size bounds; pad scrolls if these exceed the terminal.
HSV_MIN_W, HSV_MAX_W = 6, 200
HSV_MIN_H, HSV_MAX_H = 6, 100


def auto_plane_size(cols=None, rows=None):
	"""Pick a default (w, h) for the HSV / truecolor plane. If cols/rows are
	given, sizes for that terminal; otherwise queries the live terminal size.
	Falls back to 30x12 if get_terminal_size fails."""
	if cols is None or rows is None:
		try:
			cols, rows = os.get_terminal_size()
		except OSError:
			return 30, 12
	w = max(HSV_MIN_W, min(HSV_MAX_W, (cols - HSV_OVERHEAD_COLS) // HSV_CELL_W))
	h = max(HSV_MIN_H, min(HSV_MAX_H, rows - HSV_OVERHEAD_ROWS))
	return w, h


## ---------- Swatch layout: mirrors term/xterm-color-list.sh ----------

def build_layout():
	rows = [list(range(0, 8)), list(range(8, 16)), GAP]
	for r in range(16, 232, 6):
		rows.append(list(range(r, r + 6)))
	rows.append(GAP)
	for r in range(232, 256, 6):
		rows.append(list(range(r, r + 6)))
	return rows


def build_position_map(layout):
	pos = {}
	for ri, row in enumerate(layout):
		if row is GAP:
			continue
		for ci, idx in enumerate(row):
			pos[idx] = (ri, ci)
	return pos


## ---------- Colour math ----------

def _srgb_channel_to_linear(c):
	"""sRGB 0..1 -> linear-light 0..1 (inverse sRGB transfer function)."""
	return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def srgb_to_oklab(r, g, b):
	"""8-bit sRGB -> OKLab (Björn Ottosson, 2020). Perceptually uniform: plain
	Euclidean distance in this space approximates human-perceived difference."""
	r = _srgb_channel_to_linear(r / 255)
	g = _srgb_channel_to_linear(g / 255)
	b = _srgb_channel_to_linear(b / 255)
	l_ = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
	m_ = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
	s_ = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
	l = l_ ** (1.0 / 3); m = m_ ** (1.0 / 3); s = s_ ** (1.0 / 3)
	return (
		0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
		1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
		0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
	)


_OKLAB_LUT = None  ## precomputed OKLab for every xterm-256 index

def _ensure_oklab_lut():
	global _OKLAB_LUT
	if _OKLAB_LUT is not None:
		return
	_OKLAB_LUT = [srgb_to_oklab(*xterm_to_rgb(i)) for i in range(256)]


def rgb_to_xterm256(r, g, b):
	"""Nearest xterm-256 index for an 8-bit RGB triple, measured in OKLab so
	the match follows perception, not raw RGB distance. Only considers the
	cube (16-231) and grey ramp (232-255); system colours 0-15 are reachable
	via the swatch grid, not by nearest-match."""
	_ensure_oklab_lut()
	tL, tA, tB = srgb_to_oklab(r, g, b)
	best_i, best_d = 16, float("inf")
	for i in range(16, 256):
		L, A, B = _OKLAB_LUT[i]
		d = (tL - L) ** 2 + (tA - A) ** 2 + (tB - B) ** 2
		if d < best_d:
			best_d = d
			best_i = i
	return best_i


def hex_to_xterm256(hexstr):
	r, g, b = hex_to_rgb(hexstr)
	if r is None: return None
	return rgb_to_xterm256(r, g, b)


def hex_to_rgb(hexstr):
	s = hexstr.lstrip("#")
	if len(s) == 3:
		try: return tuple(int(c, 16) * 17 for c in s)
		except ValueError: return (None, None, None)
	if len(s) == 6:
		try: return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
		except ValueError: return (None, None, None)
	return (None, None, None)


def xterm_to_rgb(idx):
	"""Return approximate (r,g,b) for an xterm-256 index. Uses xterm's classic
	values for the 16 system colours; exact values for cube and grey."""
	if idx < 16:
		## xterm's default 16-colour palette
		return ((  0,   0,   0), (205,   0,   0), (  0, 205,   0), (205, 205,   0),
		        (  0,   0, 238), (205,   0, 205), (  0, 205, 205), (229, 229, 229),
		        (127, 127, 127), (255,   0,   0), (  0, 255,   0), (255, 255,   0),
		        ( 92,  92, 255), (255,   0, 255), (  0, 255, 255), (255, 255, 255))[idx]
	if idx < 232:
		i = idx - 16
		return CUBE_VALUES[i // 36], CUBE_VALUES[(i // 6) % 6], CUBE_VALUES[i % 6]
	v = 8 + 10 * (idx - 232)
	return v, v, v


def hsv_to_rgb(h, s, v):
	"""h in degrees, s and v in [0,1]; returns 8-bit RGB tuple."""
	h = h % 360
	c = v * s
	x = c * (1 - abs((h / 60) % 2 - 1))
	m = v - c
	if   h <  60: r, g, b = c, x, 0
	elif h < 120: r, g, b = x, c, 0
	elif h < 180: r, g, b = 0, c, x
	elif h < 240: r, g, b = 0, x, c
	elif h < 300: r, g, b = x, 0, c
	else:         r, g, b = c, 0, x
	return int(round((r + m) * 255)), int(round((g + m) * 255)), int(round((b + m) * 255))


def rgb_to_hsv(r, g, b):
	rn, gn, bn = r / 255, g / 255, b / 255
	mx, mn = max(rn, gn, bn), min(rn, gn, bn)
	d = mx - mn
	v = mx
	s = 0 if mx == 0 else d / mx
	if d == 0:    h = 0
	elif mx == rn: h = 60 * (((gn - bn) / d) % 6)
	elif mx == gn: h = 60 * ((bn - rn) / d + 2)
	else:          h = 60 * ((rn - gn) / d + 4)
	return h % 360, s, v


def parse_initial(s):
	if not s:
		return None, None
	s = s.strip()
	m = re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", s)
	if m:
		h = m.group(1).lower()
		if len(h) == 3:
			h = "".join(c * 2 for c in h)
		return "hex", "#" + h
	m = re.fullmatch(r"(?:colou?r)?(\d{1,3})", s, re.IGNORECASE)
	if m:
		n = int(m.group(1))
		if 0 <= n <= 255:
			return "num", n
	return None, s


def _luma(idx):
	r, g, b = xterm_to_rgb(idx)
	return int(0.299 * r + 0.587 * g + 0.114 * b)


## ---------- Preview ----------

def run_preview(cmd, color):
	if not cmd or not color:
		return
	full = cmd + " " + shlex.quote(color)
	try:
		subprocess.run(["sh", "-c", full], check=False,
		               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	except Exception:
		pass


## ---------- Curses helpers ----------

def init_color_pairs():
	"""Init one curses pair per xterm-256 colour. We use pair index = colour
	index for colours 1..255 (256 pairs is the legacy COLOR_PAIRS cap, with
	pair 0 reserved for default). Colour 0 (black) doesn't get its own pair —
	pair 0's default fg/bg (under use_default_colors) is the terminal default,
	which on dark terminals reads as black anyway, so it serves as a fine
	stand-in."""
	if not curses.has_colors():
		return
	curses.start_color()
	try:
		curses.use_default_colors()
	except curses.error:
		pass
	for i in range(1, min(curses.COLORS, 256)):
		try:
			fg = curses.COLOR_BLACK if _luma(i) > 130 else curses.COLOR_WHITE
			curses.init_pair(i, fg, i)
		except curses.error:
			pass


def safe_addstr(win, y, x, text, attr=0):
	try:
		win.addstr(y, x, text, attr)
	except curses.error:
		pass


## ---------- Swatch mode rendering ----------

def draw_swatch(pad, layout, sel_idx, hex_mode, hex_buf):
	pad.erase()
	hex_idx = None
	if hex_mode and len(hex_buf) in (3, 6):
		h = hex_buf if len(hex_buf) == 6 else "".join(c * 2 for c in hex_buf)
		hex_idx = hex_to_xterm256("#" + h)
	for ri, row in enumerate(layout):
		if row is GAP:
			continue
		x = 1
		for idx in row:
			text = f" {idx:3d} "
			attr = curses.color_pair(idx)
			highlighted = (not hex_mode and idx == sel_idx) or (idx == hex_idx)
			if highlighted:
				attr |= curses.A_REVERSE | curses.A_BOLD
			safe_addstr(pad, ri, x, text, attr)
			x += CELL_W + 1


def _next_non_gap(layout, from_row, target_col, direction):
	r = from_row + direction
	while 0 <= r < len(layout):
		if layout[r] is not GAP:
			row = layout[r]
			return row[min(target_col, len(row) - 1)]
		r += direction
	return None


## ---------- HSV mode rendering ----------

def hsv_cell_color(hue_deg, s, v):
	r, g, b = hsv_to_rgb(hue_deg, s, v)
	return rgb_to_xterm256(r, g, b)


def truecolor_cell_seq(y, x, text, r, g, b, mark=False):
	"""Build a raw ANSI escape that paints (y,x) with a 24-bit background and
	`text`. If mark, also set a contrasting foreground (black/white per luma)
	so the cursor glyph stays visible on any bg. Coords are 0-based curses
	coords; ANSI's 1-based offset is added here."""
	seq = f"\033[{y+1};{x+1}H\033[48;2;{r};{g};{b}m"
	if mark:
		luma = 0.299 * r + 0.587 * g + 0.114 * b
		fr, fg, fb = (0, 0, 0) if luma > 130 else (255, 255, 255)
		seq += f"\033[38;2;{fr};{fg};{fb}m"
	seq += text
	seq += "\033[0m"
	return seq


_HSV_PLANE_CACHE = {}  ## (hue_idx, hue_steps, w, h) -> 2D nearest-xterm-256 index list
_HSV_PLANE_CACHE_CAP = 64  ## FIFO eviction so heavy zooming doesn't grow unbounded

def hsv_plane_indices(hue_idx, hue_steps, w, h):
	"""Cached: precomputed nearest-xterm-256 for every (sv_x, sv_y) cell at this
	hue/dim combo. ~w*h OKLab lookups per build; once cached, redraw is paint."""
	key = (hue_idx, hue_steps, w, h)
	plane = _HSV_PLANE_CACHE.get(key)
	if plane is not None:
		return plane
	hue_deg = hue_idx * (360.0 / hue_steps)
	plane = [[0] * w for _ in range(h)]
	for yy in range(h):
		v = 1 - yy / (h - 1) if h > 1 else 1
		for xx in range(w):
			s = xx / (w - 1) if w > 1 else 0
			r, g, b = hsv_to_rgb(hue_deg, s, v)
			plane[yy][xx] = rgb_to_xterm256(r, g, b)
	if len(_HSV_PLANE_CACHE) >= _HSV_PLANE_CACHE_CAP:
		_HSV_PLANE_CACHE.pop(next(iter(_HSV_PLANE_CACHE)))
	_HSV_PLANE_CACHE[key] = plane
	return plane


def hsv_at(hue_idx, sv_x, sv_y, hue_steps, w, h):
	"""Convert HSV grid coordinates to (h_deg, s, v, r, g, b)."""
	hue_deg = hue_idx * (360.0 / hue_steps)
	s = sv_x / (w - 1) if w > 1 else 0
	v = 1 - sv_y / (h - 1) if h > 1 else 1
	r, g, b = hsv_to_rgb(hue_deg, s, v)
	return hue_deg, s, v, r, g, b


def hue_pad_dims(hue_steps):
	"""1-row pad sized to hold the whole hue ramp."""
	return (1, len(HUE_LABEL) + hue_steps * HSV_CELL_W + 2)


def plane_pad_dims(w, h):
	"""Pad sized to hold the SV plane."""
	return (max(1, h), max(1, w * HSV_CELL_W) + 2)


def draw_hsv_hue(pad, hue_idx, hue_steps):
	"""Paint the hue strip into a 1-row pad with xterm-256 banded colours.
	Used only in HSV mode — in truecolor mode the hue strip is painted via
	`compute_truecolor_cells` overlay and curses is left untouched there."""
	pad.erase()
	safe_addstr(pad, 0, 0, HUE_LABEL, curses.A_BOLD)
	x = len(HUE_LABEL)
	for i in range(hue_steps):
		hue_deg = i * (360.0 / hue_steps)
		r, g, b = hsv_to_rgb(hue_deg, 1.0, 1.0)
		idx = rgb_to_xterm256(r, g, b)
		is_cursor = (i == hue_idx)
		attr = curses.color_pair(idx)
		cell_text = " " * HSV_CELL_W
		if is_cursor:
			attr |= curses.A_REVERSE | curses.A_BOLD
			cell_text = "><"
		safe_addstr(pad, 0, x, cell_text, attr)
		x += HSV_CELL_W


def draw_hsv_plane(pad, sv_x, sv_y, hex_mode, hue_idx, hue_steps, w, h):
	"""Paint the SV plane into a pad with xterm-256 banded colours. Used only
	in HSV mode — see draw_hsv_hue."""
	pad.erase()
	plane = hsv_plane_indices(hue_idx, hue_steps, w, h)
	for yy in range(h):
		for xx in range(w):
			idx = plane[yy][xx]
			cell_x = xx * HSV_CELL_W
			is_cursor = (xx == sv_x and yy == sv_y and not hex_mode)
			attr = curses.color_pair(idx)
			cell_text = " " * HSV_CELL_W
			if is_cursor:
				attr |= curses.A_REVERSE | curses.A_BOLD
				cell_text = "><"
			safe_addstr(pad, yy, cell_x, cell_text, attr)


def compute_truecolor_cells(hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
                            plane_scroll_y, plane_scroll_x,
                            plane_view_rows, plane_view_cols,
                            hue_scroll_x, hue_view_cols):
	"""Build the dict of visible truecolor cells: (screen_y, screen_x) ->
	(r, g, b, mark). Combines the hue strip and the SV plane.

	The caller diffs this against a previous-frame dict and emits ANSI escapes
	only for cells whose value changed — so cursor-only moves emit ~2 cells.
	Curses is told to leave these screen positions alone (via untouchline),
	so no banded backing is sent that could flash through."""
	cells = {}
	## Hue strip
	label_w = len(HUE_LABEL)
	for i in range(hue_steps):
		pad_x = label_w + i * HSV_CELL_W
		if pad_x < hue_scroll_x or pad_x + HSV_CELL_W > hue_scroll_x + hue_view_cols:
			continue
		hue_deg = i * (360.0 / hue_steps)
		r, g, b = hsv_to_rgb(hue_deg, 1.0, 1.0)
		is_cursor = (i == hue_idx)
		screen_y = HUE_SCREEN_Y
		screen_x = pad_x - hue_scroll_x
		cells[(screen_y, screen_x)] = (r, g, b, is_cursor)
	## SV plane
	cur_hue_deg = hue_idx * (360.0 / hue_steps)
	for yy in range(h_plane):
		if yy < plane_scroll_y or yy >= plane_scroll_y + plane_view_rows:
			continue
		for xx in range(w):
			cell_x_pad = xx * HSV_CELL_W
			if cell_x_pad < plane_scroll_x \
			        or cell_x_pad + HSV_CELL_W > plane_scroll_x + plane_view_cols:
				continue
			s = xx / (w - 1) if w > 1 else 0
			v = 1 - yy / (h_plane - 1) if h_plane > 1 else 1
			r, g, b = hsv_to_rgb(cur_hue_deg, s, v)
			is_cursor = (xx == sv_x and yy == sv_y and not hex_mode)
			screen_y = PLANE_SCREEN_TOP + (yy - plane_scroll_y)
			screen_x = HSV_PLANE_INDENT + (cell_x_pad - plane_scroll_x)
			cells[(screen_y, screen_x)] = (r, g, b, is_cursor)
	return cells


def emit_truecolor_diff(prev_cells, new_cells):
	"""Return concatenated ANSI escapes for cells whose value differs from
	the previous frame. Mutates prev_cells in place to become new_cells."""
	out = []
	for key, val in new_cells.items():
		if prev_cells.get(key) != val:
			y, x = key
			r, g, b, mark = val
			out.append(truecolor_cell_seq(y, x, "><" if mark else "  ",
			                              r, g, b, mark=mark))
	prev_cells.clear()
	prev_cells.update(new_cells)
	return "".join(out)


## ---------- Main picker loop ----------

def picker(stdscr, layout, pos_map, initial_idx, preview_cmd, allow_hex,
           init_w, init_h, init_hue_steps, hue_steps_explicit, size_explicit):
	curses.curs_set(0)
	init_color_pairs()
	stdscr.keypad(True)

	## Swatch state
	sel_idx = initial_idx if initial_idx in pos_map else 0
	intended_col = pos_map[sel_idx][1]
	num_buf = ""

	## HSV plane dims — mutable via zoom keys. w is bumped by
	## HSV_PLANE_STRETCH_CELLS so the plane's right edge aligns with the hue
	## strip's right edge (label takes that much extra width on the left).
	w, h_plane = init_w + HSV_PLANE_STRETCH_CELLS, init_h
	hue_steps = init_hue_steps

	## current_rgb is the underlying value. Tab does NOT touch it; movement does.
	current_rgb = xterm_to_rgb(sel_idx)
	hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)

	mode = "hsv"  ## default — banded full-spectrum picker
	hex_mode = False
	hex_buf = ""
	status_msg = ""

	## Swatch pad (size fixed)
	rows_total = len(layout)
	cols_total = max(len(r) for r in layout if r is not GAP)
	swatch_pad_h = rows_total + 1
	swatch_pad_w = cols_total * (CELL_W + 1) + 4
	swatch_pad = curses.newpad(swatch_pad_h, swatch_pad_w)

	## HSV uses two pads so the hue strip stays put while the plane scrolls.
	hue_pad_h, hue_pad_w = hue_pad_dims(hue_steps)
	hue_pad = curses.newpad(hue_pad_h, hue_pad_w)
	plane_pad_h, plane_pad_w = plane_pad_dims(w, h_plane)
	plane_pad = curses.newpad(plane_pad_h, plane_pad_w)

	## Movement key tuples — hoisted out of the loop
	LEFT_1  = (curses.KEY_LEFT,  ord('h'), ord('a'))
	LEFT_5  = (curses.KEY_SLEFT, ord('H'), ord('A'))
	RIGHT_1 = (curses.KEY_RIGHT, ord('l'), ord('d'))
	RIGHT_5 = (curses.KEY_SRIGHT, ord('L'), ord('D'))
	UP_1    = (curses.KEY_UP,    ord('k'), ord('w'))
	UP_5    = (curses.KEY_SR,    ord('K'), ord('W'))
	DOWN_1  = (curses.KEY_DOWN,  ord('j'), ord('s'))
	DOWN_5  = (curses.KEY_SF,    ord('J'), ord('S'))
	HUE_BACK_1    = (ord(','), ord('q'), ord('u'))
	HUE_BACK_5    = (ord('<'), ord('Q'), ord('U'))
	HUE_FORWARD_1 = (ord('.'), ord('e'), ord('o'))
	HUE_FORWARD_5 = (ord('>'), ord('E'), ord('O'))
	FIVE_X = set(LEFT_5 + RIGHT_5 + UP_5 + DOWN_5 + HUE_BACK_5 + HUE_FORWARD_5)

	def current_color_str():
		if hex_mode:
			if len(hex_buf) == 3:
				return "#" + "".join(c * 2 for c in hex_buf)
			if len(hex_buf) == 6:
				return "#" + hex_buf
			return None
		r, g, b = current_rgb
		if mode == "truecolor":
			return f"#{r:02x}{g:02x}{b:02x}"
		if mode == "swatch":
			return f"colour{sel_idx}"
		## hsv: quantised projection of current_rgb
		return f"colour{rgb_to_xterm256(r, g, b)}"

	def preview():
		run_preview(preview_cmd, current_color_str())

	def set_value_from_hsv():
		"""Reads cursor (hue_idx, sv_x, sv_y) and writes current_rgb + sel_idx."""
		nonlocal current_rgb, sel_idx, intended_col
		_, _, _, r, g, b = hsv_at(hue_idx, sv_x, sv_y, hue_steps, w, h_plane)
		current_rgb = (r, g, b)
		sel_idx = rgb_to_xterm256(r, g, b)
		if sel_idx in pos_map:
			intended_col = pos_map[sel_idx][1]

	def set_value_from_swatch():
		"""Reads sel_idx and writes current_rgb + hue cursor."""
		nonlocal current_rgb, hue_idx, sv_x, sv_y
		current_rgb = xterm_to_rgb(sel_idx)
		hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)

	def commit_num_buf():
		nonlocal sel_idx, num_buf, intended_col
		if not num_buf:
			return
		n = int(num_buf)
		num_buf = ""
		if 0 <= n <= 255:
			sel_idx = n
			intended_col = pos_map[sel_idx][1]
			set_value_from_swatch()
			preview()

	## Truecolor overlay state: maps (screen_y, screen_x) -> (r, g, b, mark) for
	## what we last painted via raw ANSI. Used to diff each frame and emit only
	## the cells that changed. Reset whenever the screen layout changes (mode
	## switch, zoom, resize) so the next frame does a full repaint.
	truecolor_state = {}

	def apply_dims(new_w, new_h):
		"""Set plane to (new_w, new_h), recouple hue if not pinned, resize pads,
		and resync the cursor from current_rgb. current_rgb is preserved."""
		nonlocal w, h_plane, hue_steps, hue_idx, sv_x, sv_y, plane_pad, plane_pad_h, plane_pad_w
		nonlocal hue_pad, hue_pad_h, hue_pad_w
		new_w = max(HSV_MIN_W, min(HSV_MAX_W, new_w))
		new_h = max(HSV_MIN_H, min(HSV_MAX_H, new_h))
		new_hue = hue_steps if hue_steps_explicit else max(HSV_MIN_W,
		                                                   min(HSV_MAX_W,
		                                                       new_w - HSV_PLANE_STRETCH_CELLS))
		if new_w == w and new_h == h_plane and new_hue == hue_steps:
			return
		w, h_plane, hue_steps = new_w, new_h, new_hue
		hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)
		hue_pad_h, hue_pad_w = hue_pad_dims(hue_steps)
		hue_pad = curses.newpad(hue_pad_h, hue_pad_w)
		plane_pad_h, plane_pad_w = plane_pad_dims(w, h_plane)
		plane_pad = curses.newpad(plane_pad_h, plane_pad_w)
		truecolor_state.clear()  ## force full overlay repaint at new dims
		preview()

	def apply_zoom(dw, dh):
		"""Value stays exact across zoom — cursor resyncs from current_rgb."""
		apply_dims(w + dw, h_plane + dh)

	def apply_auto_resize():
		"""Recompute plane dims from the live terminal size. Skipped when the
		user pinned a size via --size."""
		if size_explicit:
			return
		try:
			cols, rows = os.get_terminal_size()
		except OSError:
			rows, cols = stdscr.getmaxyx()
		auto_w, auto_h = auto_plane_size(cols, rows)
		apply_dims(auto_w + HSV_PLANE_STRETCH_CELLS, auto_h)

	while True:
		term_h, term_w = stdscr.getmaxyx()
		stdscr.erase()
		title = "Select an xterm-256 / hex colour"
		safe_addstr(stdscr, 0, max(0, (term_w - len(title)) // 2), title, curses.A_BOLD)

		sel_str = current_color_str()
		cur_r, cur_g, cur_b = current_rgb
		if mode == "truecolor":
			extras = f"  (nearest: colour{rgb_to_xterm256(cur_r, cur_g, cur_b)})"
		elif mode == "hsv":
			extras = f"  (full: #{cur_r:02x}{cur_g:02x}{cur_b:02x})"
		else:
			extras = f"  (#{cur_r:02x}{cur_g:02x}{cur_b:02x})"
		next_mode = {"hsv": "truecolor", "truecolor": "swatch", "swatch": "hsv"}[mode]
		dims = f" {w}x{h_plane}" if mode != "swatch" else ""
		line1 = f" [{mode}{dims}]  Selection: {sel_str or '(typing...)'}{extras}"
		if num_buf:
			line1 += f"   typing: {num_buf}_"
		if hex_mode:
			line1 += f"   hex: #{hex_buf}{'_' * (6 - len(hex_buf))}"
		if status_msg:
			line1 += f"   ({status_msg})"
		if mode == "swatch":
			help_line = " arrows/hjkl/wasd move (Shift=5)  0-9 num" + \
			            ("  # hex" if allow_hex else "") + \
			            f"  Tab→{next_mode}  Enter accept  Esc cancel"
		else:
			help_line = " arrows/hjkl/wasd SV (Shift=5)  ,./qe/uo hue (Shift=5)  +/- zoom" + \
			            ("  # hex" if allow_hex else "") + \
			            f"  Tab→{next_mode}  Enter  Esc"

		## Fixed top: title row 0, hue strip row 2, label row 3.
		## Plane sits at row 4..term_h-4 (status + help take the last two).
		## HUE_SCREEN_Y / LABEL_SCREEN_Y / PLANE_SCREEN_TOP are module-level.
		swatch_top = 2

		if mode != "swatch":
			cur_hue_deg = hue_idx * (360.0 / hue_steps)
			label_text = f"Sat→   V↕   H={cur_hue_deg:5.1f}°"
			safe_addstr(stdscr, LABEL_SCREEN_Y, HSV_PLANE_INDENT,
			            label_text[:max(0, term_w - HSV_PLANE_INDENT - 1)],
			            curses.A_DIM)

		safe_addstr(stdscr, term_h - 3, 0, line1[:max(0, term_w - 1)])
		safe_addstr(stdscr, term_h - 2, 0, help_line[:max(0, term_w - 1)], curses.A_DIM)

		if mode == "swatch":
			swatch_view_rows = max(1, term_h - swatch_top - 3)
			draw_swatch(swatch_pad, layout, sel_idx, hex_mode, hex_buf)
			sel_row = pos_map[sel_idx][0]
			scroll_y = max(0, min(max(0, swatch_pad_h - swatch_view_rows),
			                       sel_row - swatch_view_rows + 2))
			stdscr.noutrefresh()
			try:
				swatch_pad.noutrefresh(scroll_y, 0, swatch_top, 0,
				                       swatch_top + swatch_view_rows - 1, max(0, term_w - 1))
			except curses.error:
				pass
			curses.doupdate()
		else:
			## Compute scroll positions and visible window dimensions (shared
			## between hsv and truecolor branches).
			view_cols = max(1, term_w)
			hue_cursor_pad_x = len(HUE_LABEL) + hue_idx * HSV_CELL_W
			hue_scroll_x = 0
			if hue_pad_w > view_cols:
				hue_scroll_x = max(0, min(hue_pad_w - view_cols,
				                          hue_cursor_pad_x - view_cols // 2))
			plane_view_rows = max(1, term_h - PLANE_SCREEN_TOP - 4)
			plane_view_cols = max(1, term_w - HSV_PLANE_INDENT)
			cursor_pad_y = sv_y
			cursor_pad_x = sv_x * HSV_CELL_W
			plane_scroll_y = 0
			if plane_pad_h > plane_view_rows:
				plane_scroll_y = max(0, min(plane_pad_h - plane_view_rows,
				                            cursor_pad_y - plane_view_rows // 2))
			plane_scroll_x = 0
			if plane_pad_w > plane_view_cols:
				plane_scroll_x = max(0, min(plane_pad_w - plane_view_cols,
				                            cursor_pad_x - plane_view_cols // 2))

			if mode == "truecolor":
				## Truecolor mode: NO curses pad painting for plane/hue. We paint
				## those cells purely via raw ANSI overlay, tracking per-cell state
				## so cursor-only moves emit ~2 cells (not ~19 KB of escapes).
				## Untouch the screen rows that the overlay owns, so curses won't
				## "fix" them on refresh — its diff for those rows is skipped.
				try:
					stdscr.touchline(HUE_SCREEN_Y, 1, False)
					stdscr.touchline(PLANE_SCREEN_TOP, plane_view_rows, False)
				except curses.error:
					pass
				new_cells = compute_truecolor_cells(
					hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
					plane_scroll_y, plane_scroll_x,
					plane_view_rows, plane_view_cols,
					hue_scroll_x, view_cols)
				diffs = emit_truecolor_diff(truecolor_state, new_cells)
				stdscr.noutrefresh()
				curses.doupdate()
				if diffs:
					sys.stdout.write(diffs)
					sys.stdout.flush()
			else:
				## HSV mode: curses pads carry the banded backing.
				draw_hsv_hue(hue_pad, hue_idx, hue_steps)
				draw_hsv_plane(plane_pad, sv_x, sv_y, hex_mode,
				               hue_idx, hue_steps, w, h_plane)
				stdscr.noutrefresh()
				try:
					hue_pad.noutrefresh(0, hue_scroll_x,
					                    HUE_SCREEN_Y, 0,
					                    HUE_SCREEN_Y, max(0, term_w - 1))
					plane_pad.noutrefresh(plane_scroll_y, plane_scroll_x,
					                      PLANE_SCREEN_TOP, HSV_PLANE_INDENT,
					                      PLANE_SCREEN_TOP + plane_view_rows - 1,
					                      max(0, term_w - 1))
				except curses.error:
					pass
				curses.doupdate()

		try:
			ch = stdscr.getch()
		except KeyboardInterrupt:
			return ("cancel", None)
		status_msg = ""

		if ch == curses.KEY_RESIZE:
			apply_auto_resize()
			continue

		## Hex sub-mode (active in both swatch and hsv modes)
		if hex_mode:
			if ch == 27:
				hex_mode = False
				hex_buf = ""
				preview()
				continue
			if ch in (curses.KEY_ENTER, 10, 13):
				if len(hex_buf) in (3, 6):
					if len(hex_buf) == 3:
						hex_buf = "".join(c * 2 for c in hex_buf)
					return ("hex", "#" + hex_buf)
				status_msg = "need 3 or 6 hex digits"
				continue
			if ch in (curses.KEY_BACKSPACE, 127, 8):
				hex_buf = hex_buf[:-1]
				preview()
				continue
			if 32 <= ch < 127:
				c = chr(ch).lower()
				if c in "0123456789abcdef" and len(hex_buf) < 6:
					hex_buf += c
					if len(hex_buf) in (3, 6):
						h_str = hex_buf if len(hex_buf) == 6 else "".join(c2 * 2 for c2 in hex_buf)
						rr, gg, bb = hex_to_rgb("#" + h_str)
						if rr is not None:
							current_rgb = (rr, gg, bb)
							sel_idx = rgb_to_xterm256(rr, gg, bb)
							if sel_idx in pos_map:
								intended_col = pos_map[sel_idx][1]
							hue_idx, sv_x, sv_y = sync_hsv_from_rgb(rr, gg, bb,
							                                       hue_steps, w, h_plane)
						preview()
			continue

		## Common keys
		if ch == 27:  ## Esc — the only cancel key (q is hue in hsv mode)
			return ("cancel", None)
		if ch == 9:  ## Tab — cycle hsv -> truecolor -> swatch -> hsv.
			## NOTE: Tab is value-preserving: it does NOT touch current_rgb,
			## hue_idx, sv_x, sv_y, or sel_idx. Only `mode` changes; the
			## display projection of current_rgb adapts per mode.
			old_mode = mode
			if mode == "hsv":
				mode = "truecolor"
			elif mode == "truecolor":
				mode = "swatch"
			else:
				mode = "hsv"
			## Reset truecolor state — any entry to truecolor mode starts with
			## a fresh full overlay paint over the prior mode's cells.
			truecolor_state.clear()
			## If we're leaving truecolor, curses' physical-screen model still
			## thinks the plane/hue area has whatever-was-there before we entered
			## truecolor (since our overlay writes bypassed it). Force curses to
			## resend the whole area so it can paint the new mode's content over
			## our truecolor cells. touchwin is one-shot, unlike clearok which
			## would re-clear on every subsequent refresh.
			if old_mode == "truecolor":
				stdscr.touchwin()
				hue_pad.touchwin()
				plane_pad.touchwin()
				swatch_pad.touchwin()
			preview()
			continue
		if ch == ord('#') and allow_hex:
			commit_num_buf()
			hex_mode = True
			hex_buf = ""
			continue
		if ch in (curses.KEY_ENTER, 10, 13, ord(' ')):
			if mode == "swatch" and num_buf:
				commit_num_buf()
				continue
			if mode == "swatch":
				return ("num", sel_idx)
			r, g, b = current_rgb
			if mode == "truecolor":
				return ("hex", f"#{r:02x}{g:02x}{b:02x}")
			## hsv: quantise the underlying value when accepting
			return ("num", rgb_to_xterm256(r, g, b))

		## Movement + zoom
		step = 5 if ch in FIVE_X else 1

		if mode == "swatch":
			if ch in LEFT_1 + LEFT_5:
				commit_num_buf()
				new_idx = max(0, sel_idx - step)
				if new_idx != sel_idx:
					sel_idx = new_idx
					intended_col = pos_map[sel_idx][1]
					set_value_from_swatch()
					preview()
			elif ch in RIGHT_1 + RIGHT_5:
				commit_num_buf()
				new_idx = min(255, sel_idx + step)
				if new_idx != sel_idx:
					sel_idx = new_idx
					intended_col = pos_map[sel_idx][1]
					set_value_from_swatch()
					preview()
			elif ch in UP_1 + UP_5:
				commit_num_buf()
				new_idx = sel_idx
				for _ in range(step):
					tmp = _next_non_gap(layout, pos_map[new_idx][0], intended_col, -1)
					if tmp is None:
						break
					new_idx = tmp
				if new_idx != sel_idx:
					sel_idx = new_idx
					set_value_from_swatch()
					preview()
			elif ch in DOWN_1 + DOWN_5:
				commit_num_buf()
				new_idx = sel_idx
				for _ in range(step):
					tmp = _next_non_gap(layout, pos_map[new_idx][0], intended_col, +1)
					if tmp is None:
						break
					new_idx = tmp
				if new_idx != sel_idx:
					sel_idx = new_idx
					set_value_from_swatch()
					preview()
			elif ch in (curses.KEY_BACKSPACE, 127, 8):
				num_buf = num_buf[:-1]
			elif 48 <= ch <= 57:
				digit = chr(ch)
				candidate = num_buf + digit
				if int(candidate) > 255:
					commit_num_buf()
					num_buf = digit
				else:
					num_buf = candidate
					if len(num_buf) == 3 or int(num_buf) * 10 > 255:
						commit_num_buf()
		else:
			## HSV / truecolor: movement updates the cursor then derives
			## current_rgb from the new cell — the user has committed to that
			## position, so quantisation (in hsv) or the new exact RGB (in
			## truecolor) is the right "current value" going forward.
			if ch in LEFT_1 + LEFT_5:
				sv_x = max(0, sv_x - step); set_value_from_hsv(); preview()
			elif ch in RIGHT_1 + RIGHT_5:
				sv_x = min(w - 1, sv_x + step); set_value_from_hsv(); preview()
			elif ch in UP_1 + UP_5:
				sv_y = max(0, sv_y - step); set_value_from_hsv(); preview()
			elif ch in DOWN_1 + DOWN_5:
				sv_y = min(h_plane - 1, sv_y + step); set_value_from_hsv(); preview()
			elif ch in HUE_BACK_1 + HUE_BACK_5:
				hue_idx = (hue_idx - step) % hue_steps; set_value_from_hsv(); preview()
			elif ch in HUE_FORWARD_1 + HUE_FORWARD_5:
				hue_idx = (hue_idx + step) % hue_steps; set_value_from_hsv(); preview()
			elif ch in (ord('+'), ord('=')):
				apply_zoom(+4, +2)
			elif ch in (ord('-'), ord('_')):
				apply_zoom(-4, -2)


## ---------- Sync helpers ----------

def sync_hsv_from_idx(idx, hue_steps, w, h):
	r, g, b = xterm_to_rgb(idx)
	return sync_hsv_from_rgb(r, g, b, hue_steps, w, h)


def sync_hsv_from_rgb(r, g, b, hue_steps, w, h):
	hh, s, v = rgb_to_hsv(r, g, b)
	hue_idx = round(hh / 360 * hue_steps) % hue_steps
	sv_x = max(0, min(w - 1, round(s * (w - 1))))
	sv_y = max(0, min(h - 1, round((1 - v) * (h - 1))))
	return hue_idx, sv_x, sv_y


## ---------- Main ----------

def _parse_size(spec):
	m = re.fullmatch(r"\s*(\d+)\s*x\s*(\d+)\s*", spec)
	if not m:
		raise argparse.ArgumentTypeError(
			f"--size must look like WxH (e.g. 80x50), got: {spec!r}")
	w, h = int(m.group(1)), int(m.group(2))
	if not (HSV_MIN_W <= w <= HSV_MAX_W and HSV_MIN_H <= h <= HSV_MAX_H):
		raise argparse.ArgumentTypeError(
			f"--size out of range: width [{HSV_MIN_W},{HSV_MAX_W}],"
			f" height [{HSV_MIN_H},{HSV_MAX_H}]")
	return (w, h)


def main():
	p = argparse.ArgumentParser(
		description="Interactive xterm-256 / hex colour picker.",
		formatter_class=argparse.RawDescriptionHelpFormatter,
		epilog=__doc__.split("\n", 2)[2])
	p.add_argument("--initial", default=None,
	               help='Starting colour (NN, colourNN, or #rrggbb).')
	p.add_argument("--preview-cmd", default=None,
	               help='Shell command; selected colour is appended on each move.')
	p.add_argument("--no-hex", action="store_true", help="Disable hex entry.")
	p.add_argument("--size", type=_parse_size, default=None, metavar="WxH",
	               help="HSV plane size. Defaults to auto-fit terminal.")
	p.add_argument("--hue-steps", type=int, default=None, metavar="N",
	               help="Cells in the hue ramp. Defaults to plane width.")
	args = p.parse_args()

	if not sys.stdin.isatty():
		try:
			sys.stdin = open("/dev/tty", "r")
		except OSError:
			print("select-term256-color: no TTY for input", file=sys.stderr)
			sys.exit(2)

	saved_stdout_fd = None
	if not sys.stdout.isatty():
		try:
			tty_fd = os.open("/dev/tty", os.O_WRONLY)
			saved_stdout_fd = os.dup(1)
			os.dup2(tty_fd, 1)
			os.close(tty_fd)
		except OSError:
			print("select-term256-color: cannot open /dev/tty", file=sys.stderr)
			sys.exit(2)

	layout = build_layout()
	pos_map = build_position_map(layout)
	kind, val = parse_initial(args.initial)
	initial_idx = val if kind == "num" else (hex_to_xterm256(val) if kind == "hex" else None)

	## Resolve plane dimensions
	size_explicit = args.size is not None
	if size_explicit:
		init_w, init_h = args.size
	else:
		init_w, init_h = auto_plane_size()
	hue_steps_explicit = args.hue_steps is not None
	if hue_steps_explicit:
		init_hue_steps = max(HSV_MIN_W, min(HSV_MAX_W, args.hue_steps))
	else:
		init_hue_steps = init_w

	try:
		result = curses.wrapper(picker, layout, pos_map, initial_idx,
		                        args.preview_cmd, not args.no_hex,
		                        init_w, init_h, init_hue_steps,
		                        hue_steps_explicit, size_explicit)
	finally:
		if saved_stdout_fd is not None:
			os.dup2(saved_stdout_fd, 1)
			os.close(saved_stdout_fd)

	rkind, rval = result
	if rkind == "cancel":
		if args.preview_cmd and args.initial:
			run_preview(args.preview_cmd, args.initial)
		sys.exit(1)
	if rkind == "num":
		print(f"colour{rval}")
	elif rkind == "hex":
		print(rval)


if __name__ == "__main__":
	main()
