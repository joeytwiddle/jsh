#!/usr/bin/env python3
"""select-term256-color: interactive xterm-256 / hex colour picker.

Three modes (Tab cycles hsv -> truecolor -> swatch):

  hsv        DEFAULT. SV plane + hue ramp, painted with the nearest xterm-256
             cells (visible banding). Output is the quantised "colourNNN".
  truecolor  Same SV plane geometry but each cell is overpainted with a 24-bit
             ANSI escape, so the gradient is smooth on truecolor terminals.
             Output is the exact "#rrggbb". Falls back to hsv-style banding on
             non-truecolor terminals.
  swatch     The full 256 xterm colours laid out as in xterm-color-list.sh.
             Output is "colourNNN". The only place to reach system colours
             0-15.

Keys:
  arrows / hjkl / wasd   move
  0-9                    (swatch mode) type a colour index
  , . / q e              (hsv mode) shift hue
  Tab                    toggle swatch / hsv mode
  #                      enter hex mode; type 3 or 6 hex digits then Enter
  Enter / Space          accept
  q / Esc                cancel  (q quits in swatch mode; in hsv mode q is hue)

Output (on accept):
  swatch, hsv  -> "colourNNN"
  truecolor    -> "#rrggbb"
  # hex entry  -> "#rrggbb"
Exit code: 0 on accept, 1 on cancel, 2 on setup error.
"""

import argparse
import os
import re
import select
import shlex
import signal
import subprocess
import sys
import termios
import tty


GAP = None  ## visual gap between sections of the swatch layout
CELL_W = 5  ## " NNN " cell width in swatch mode
CUBE_VALUES = (0, 95, 135, 175, 215, 255)

HSV_CELL_W = 2       ## chars per cell in HSV / truecolor planes
HSV_PLANE_INDENT = 2 ## screen-column indent for the SV plane and its label row.
                     ## 2 gives a visible left margin between the screen edge and the first plane cell.
HUE_LABEL = "  Hue:" ## same-parity length as HSV_PLANE_INDENT so plane and hue cells line up vertically
HSV_PLANE_STRETCH_CELLS = 2  ## extra plane cells beyond hue_steps so plane right edge aligns
                             ## with hue right edge: indent + 2*w = len(HUE_LABEL) + 2*hue_steps

## Layout overhead used by auto_plane_size and the HSV pad sizer.
## Rows: title + blank + hue + label + blank-below-plane + status + help + cursor row = 8.
## If this is < 8, auto_h ends up 1 row taller than what's actually visible,
## and vertical cursor moves shift plane_scroll_y → the truecolor diff finds
## hundreds of changed cells → the whole plane visibly repaints. Keep it at 8.
HSV_OVERHEAD_ROWS = 8
HSV_OVERHEAD_COLS = 8  ## 6-char left label + 2-char right margin
HSV_RIGHT_MARGIN  = 2  ## kept symmetric with HSV_PLANE_INDENT; also absorbs the
                       ## 2-col-per-cell parity so the rightmost cell doesn't
                       ## land on the screen edge when zoomed and scrolled

## Screen-row positions for the HSV / truecolor layout — referenced by
## compute_truecolor_cells (module-level) so they must live up here too.
HUE_SCREEN_Y = 2
LABEL_SCREEN_Y = 3
PLANE_SCREEN_TOP = 4

## Plane size bounds; the visible area is windowed if these exceed the terminal.
HSV_MIN_W, HSV_MAX_W = 6, 200
HSV_MIN_H, HSV_MAX_H = 6, 200

## Custom key codes (>= 1000 so they don't collide with byte values).
## We parse arrow / shift-arrow escape sequences manually from stdin in raw mode.
KEY_UP     = 1000
KEY_DOWN   = 1001
KEY_LEFT   = 1002
KEY_RIGHT  = 1003
KEY_SUP    = 1010
KEY_SDOWN  = 1011
KEY_SLEFT  = 1012
KEY_SRIGHT = 1013
KEY_RESIZE = 1100


def auto_plane_size(cols=None, rows=None):
	"""Pick a default (w, h) for the HSV / truecolor plane. If cols/rows are
	given, sizes for that terminal; otherwise queries the live terminal size.
	Falls back to 30x12 if get_terminal_size fails."""
	if cols is None or rows is None:
		try:
			cols, rows = os.get_terminal_size()
		except OSError:
			return 30, 12
	w = max(HSV_MIN_W, min(HSV_MAX_W, (cols - HSV_OVERHEAD_COLS) // HSV_CELL_W))
	h = max(HSV_MIN_H, min(HSV_MAX_H, rows - HSV_OVERHEAD_ROWS))
	return w, h


## ---------- Swatch layout: mirrors term/xterm-color-list.sh ----------

def build_layout():
	rows = [list(range(0, 8)), list(range(8, 16)), GAP]
	for r in range(16, 232, 6):
		rows.append(list(range(r, r + 6)))
	rows.append(GAP)
	for r in range(232, 256, 6):
		rows.append(list(range(r, r + 6)))
	return rows


def build_position_map(layout):
	pos = {}
	for ri, row in enumerate(layout):
		if row is GAP:
			continue
		for ci, idx in enumerate(row):
			pos[idx] = (ri, ci)
	return pos


## ---------- Colour math ----------

def _srgb_channel_to_linear(c):
	"""sRGB 0..1 -> linear-light 0..1 (inverse sRGB transfer function)."""
	return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def srgb_to_oklab(r, g, b):
	"""8-bit sRGB -> OKLab (Björn Ottosson, 2020). Perceptually uniform: plain
	Euclidean distance in this space approximates human-perceived difference."""
	r = _srgb_channel_to_linear(r / 255)
	g = _srgb_channel_to_linear(g / 255)
	b = _srgb_channel_to_linear(b / 255)
	l_ = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
	m_ = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
	s_ = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
	l = l_ ** (1.0 / 3); m = m_ ** (1.0 / 3); s = s_ ** (1.0 / 3)
	return (
		0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
		1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
		0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
	)


_OKLAB_LUT = None  ## precomputed OKLab for every xterm-256 index

def _ensure_oklab_lut():
	global _OKLAB_LUT
	if _OKLAB_LUT is not None:
		return
	_OKLAB_LUT = [srgb_to_oklab(*xterm_to_rgb(i)) for i in range(256)]


def rgb_to_xterm256(r, g, b):
	"""Nearest xterm-256 index for an 8-bit RGB triple, measured in OKLab so
	the match follows perception, not raw RGB distance. Only considers the
	cube (16-231) and grey ramp (232-255); system colours 0-15 are reachable
	via the swatch grid, not by nearest-match."""
	_ensure_oklab_lut()
	tL, tA, tB = srgb_to_oklab(r, g, b)
	best_i, best_d = 16, float("inf")
	for i in range(16, 256):
		L, A, B = _OKLAB_LUT[i]
		d = (tL - L) ** 2 + (tA - A) ** 2 + (tB - B) ** 2
		if d < best_d:
			best_d = d
			best_i = i
	return best_i


def hex_to_xterm256(hexstr):
	r, g, b = hex_to_rgb(hexstr)
	if r is None: return None
	return rgb_to_xterm256(r, g, b)


def hex_to_rgb(hexstr):
	s = hexstr.lstrip("#")
	if len(s) == 3:
		try: return tuple(int(c, 16) * 17 for c in s)
		except ValueError: return (None, None, None)
	if len(s) == 6:
		try: return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
		except ValueError: return (None, None, None)
	return (None, None, None)


def xterm_to_rgb(idx):
	"""Return approximate (r,g,b) for an xterm-256 index. Uses xterm's classic
	values for the 16 system colours; exact values for cube and grey."""
	if idx < 16:
		## xterm's default 16-colour palette
		return ((  0,   0,   0), (205,   0,   0), (  0, 205,   0), (205, 205,   0),
		        (  0,   0, 238), (205,   0, 205), (  0, 205, 205), (229, 229, 229),
		        (127, 127, 127), (255,   0,   0), (  0, 255,   0), (255, 255,   0),
		        ( 92,  92, 255), (255,   0, 255), (  0, 255, 255), (255, 255, 255))[idx]
	if idx < 232:
		i = idx - 16
		return CUBE_VALUES[i // 36], CUBE_VALUES[(i // 6) % 6], CUBE_VALUES[i % 6]
	v = 8 + 10 * (idx - 232)
	return v, v, v


def hsv_to_rgb(h, s, v):
	"""h in degrees, s and v in [0,1]; returns 8-bit RGB tuple."""
	h = h % 360
	c = v * s
	x = c * (1 - abs((h / 60) % 2 - 1))
	m = v - c
	if   h <  60: r, g, b = c, x, 0
	elif h < 120: r, g, b = x, c, 0
	elif h < 180: r, g, b = 0, c, x
	elif h < 240: r, g, b = 0, x, c
	elif h < 300: r, g, b = x, 0, c
	else:         r, g, b = c, 0, x
	return int(round((r + m) * 255)), int(round((g + m) * 255)), int(round((b + m) * 255))


def rgb_to_hsv(r, g, b):
	rn, gn, bn = r / 255, g / 255, b / 255
	mx, mn = max(rn, gn, bn), min(rn, gn, bn)
	d = mx - mn
	v = mx
	s = 0 if mx == 0 else d / mx
	if d == 0:    h = 0
	elif mx == rn: h = 60 * (((gn - bn) / d) % 6)
	elif mx == gn: h = 60 * ((bn - rn) / d + 2)
	else:          h = 60 * ((rn - gn) / d + 4)
	return h % 360, s, v


def parse_initial(s):
	if not s:
		return None, None
	s = s.strip()
	m = re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", s)
	if m:
		h = m.group(1).lower()
		if len(h) == 3:
			h = "".join(c * 2 for c in h)
		return "hex", "#" + h
	m = re.fullmatch(r"(?:colou?r)?(\d{1,3})", s, re.IGNORECASE)
	if m:
		n = int(m.group(1))
		if 0 <= n <= 255:
			return "num", n
	return None, s


def _luma(idx):
	r, g, b = xterm_to_rgb(idx)
	return int(0.299 * r + 0.587 * g + 0.114 * b)


## ---------- Preview ----------

def run_preview(cmd, color):
	if not cmd or not color:
		return
	full = cmd + " " + shlex.quote(color)
	try:
		subprocess.run(["sh", "-c", full], check=False,
		               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
	except Exception:
		pass


## ---------- Terminal / input helpers (no curses) ----------

_orig_termios = None
_alt_screen_active = False
_resize_pending = False
_wakeup_r = -1
_wakeup_w = -1


def _on_sigwinch(_signum, _frame):
	global _resize_pending
	_resize_pending = True


def enter_raw_screen():
	"""Put the terminal into raw mode + alt screen + hidden cursor. Idempotent-
	ish: leave_raw_screen restores everything we touched."""
	global _orig_termios, _alt_screen_active, _wakeup_r, _wakeup_w
	fd = sys.stdin.fileno()
	_orig_termios = termios.tcgetattr(fd)
	tty.setraw(fd)
	## Self-pipe so SIGWINCH wakes a blocking select. PEP 475 makes Python
	## retry interrupted syscalls automatically, so we can't rely on EINTR;
	## set_wakeup_fd writes the signal byte to a pipe, which we select on.
	_wakeup_r, _wakeup_w = os.pipe()
	os.set_blocking(_wakeup_r, False)
	os.set_blocking(_wakeup_w, False)
	signal.set_wakeup_fd(_wakeup_w)
	signal.signal(signal.SIGWINCH, _on_sigwinch)
	sys.stdout.write("\033[?1049h\033[?25l\033[2J\033[H")
	sys.stdout.flush()
	_alt_screen_active = True


def leave_raw_screen():
	"""Restore terminal state. Safe to call even if enter failed partway."""
	global _orig_termios, _alt_screen_active, _wakeup_r, _wakeup_w
	if _alt_screen_active:
		sys.stdout.write("\033[0m\033[?25h\033[?1049l")
		try:
			sys.stdout.flush()
		except OSError:
			pass
		_alt_screen_active = False
	try:
		signal.set_wakeup_fd(-1)
	except (OSError, ValueError):
		pass
	try:
		signal.signal(signal.SIGWINCH, signal.SIG_DFL)
	except (OSError, ValueError):
		pass
	if _wakeup_r >= 0:
		try: os.close(_wakeup_r)
		except OSError: pass
		_wakeup_r = -1
	if _wakeup_w >= 0:
		try: os.close(_wakeup_w)
		except OSError: pass
		_wakeup_w = -1
	if _orig_termios is not None:
		try:
			termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, _orig_termios)
		except (OSError, termios.error):
			pass
		_orig_termios = None


def _drain_wakeup():
	while True:
		try:
			data = os.read(_wakeup_r, 4096)
		except (OSError, BlockingIOError):
			break
		if not data:
			break


def _peek_byte(timeout):
	"""Read one byte from stdin with a finite timeout. Returns int or None."""
	try:
		r, _, _ = select.select([sys.stdin], [], [], timeout)
	except (OSError, InterruptedError):
		return None
	if not r:
		return None
	try:
		b = os.read(sys.stdin.fileno(), 1)
	except (OSError, InterruptedError):
		return None
	if not b:
		return None
	return b[0]


def _parse_csi(seq):
	"""Map a CSI body (bytes; the leading ESC[ is already consumed) to a KEY_*
	constant. Final byte is 0x40-0x7E. Returns -1 for sequences we don't care
	about — caller treats those as 'no key'."""
	if seq == b"A": return KEY_UP
	if seq == b"B": return KEY_DOWN
	if seq == b"C": return KEY_RIGHT
	if seq == b"D": return KEY_LEFT
	## xterm reports Shift+Arrow as "1;2A".."1;2D".
	if seq == b"1;2A": return KEY_SUP
	if seq == b"1;2B": return KEY_SDOWN
	if seq == b"1;2C": return KEY_SRIGHT
	if seq == b"1;2D": return KEY_SLEFT
	return -1


def read_key(blocking=True):
	"""Read one keypress. Returns an int — either the raw byte (0..255) for
	plain keys or one of the KEY_* constants for special keys. Returns None
	when non-blocking and no input is ready. Returns KEY_RESIZE on SIGWINCH."""
	global _resize_pending
	fds = [sys.stdin.fileno()]
	if _wakeup_r >= 0:
		fds.append(_wakeup_r)
	timeout = None if blocking else 0
	while True:
		if _resize_pending:
			_resize_pending = False
			return KEY_RESIZE
		try:
			r, _, _ = select.select(fds, [], [], timeout)
		except (OSError, InterruptedError):
			if _resize_pending:
				_resize_pending = False
				return KEY_RESIZE
			if not blocking:
				return None
			continue
		if not r:
			return None
		if _wakeup_r in r:
			_drain_wakeup()
			if _resize_pending:
				_resize_pending = False
				return KEY_RESIZE
			if sys.stdin.fileno() not in r:
				if not blocking:
					return None
				continue
		break
	try:
		b = os.read(sys.stdin.fileno(), 1)
	except (OSError, InterruptedError):
		return None
	if not b:
		return None
	ch = b[0]
	if ch != 27:
		return ch
	## ESC: bare Esc, or the start of a CSI sequence. Short timeout to
	## distinguish: terminals send all bytes of an escape sequence in one
	## burst, so anything more than ~50ms later is a separate key.
	nxt = _peek_byte(0.05)
	if nxt is None:
		return 27
	if nxt != ord('['):
		## Alt+<x> or similar; treat as bare Esc — we don't use these.
		return 27
	seq = b""
	while True:
		b2 = _peek_byte(0.1)
		if b2 is None:
			break
		seq += bytes([b2])
		if 0x40 <= b2 <= 0x7E:
			break
	parsed = _parse_csi(seq)
	## Unknown CSI: report as bare Esc so the user can still cancel; better
	## than returning a value that aliases a real key.
	return 27 if parsed == -1 else parsed


def clear_screen():
	sys.stdout.write("\033[2J\033[H")


def write_at(y, x, text, bold=False, dim=False):
	"""Write text at 0-based (y, x). ANSI uses 1-based so we add 1."""
	pre = ""
	if bold: pre += "\033[1m"
	if dim:  pre += "\033[2m"
	if pre:
		sys.stdout.write(f"\033[{y+1};{x+1}H{pre}{text}\033[0m")
	else:
		sys.stdout.write(f"\033[{y+1};{x+1}H{text}")


def get_terminal_size():
	"""Return (rows, cols) — matches curses.getmaxyx() order."""
	try:
		sz = os.get_terminal_size()
		return sz.lines, sz.columns
	except OSError:
		return 24, 80


## ---------- Swatch mode rendering ----------

def compute_swatch_cells(layout, sel_idx, hex_mode, hex_buf,
                          scroll_y, view_rows, view_cols, screen_top):
	"""Visible swatch cells as {(screen_y, screen_x) -> (idx, mark)}.
	Each cell paints a 5-char " NNN " label. Mirrors the layout from
	xterm-color-list.sh — rows = layout rows (with GAP rows skipped but
	still consuming a row index)."""
	cells = {}
	hex_idx = None
	if hex_mode and len(hex_buf) in (3, 6):
		h = hex_buf if len(hex_buf) == 6 else "".join(c * 2 for c in hex_buf)
		hex_idx = hex_to_xterm256("#" + h)
	for ri, row in enumerate(layout):
		if row is GAP:
			continue
		screen_y = screen_top + (ri - scroll_y)
		if screen_y < screen_top or screen_y >= screen_top + view_rows:
			continue
		x = 1
		for idx in row:
			if x + CELL_W > view_cols:
				break
			highlighted = (not hex_mode and idx == sel_idx) or (idx == hex_idx)
			cells[(screen_y, x)] = (idx, highlighted)
			x += CELL_W + 1
	return cells


def swatch_cell_seq(y, x, idx, mark):
	"""Raw ANSI for a 5-char ' NNN ' swatch cell. Contrast fg chosen by luma."""
	fg = 16 if _luma(idx) > 130 else 231
	attrs = "\033[1;7m" if mark else ""  ## bold + reverse
	return (f"\033[{y+1};{x+1}H{attrs}\033[48;5;{idx}m\033[38;5;{fg}m"
	        f" {idx:3d} \033[0m")


def emit_swatch_diff(prev_cells, new_cells):
	"""Emit only the cells whose (idx, mark) tuple changed. Cells that
	disappeared (scrolled off, layout shrunk) are blanked with 5 spaces so
	we don't leave ghosts behind."""
	out = []
	for key, val in new_cells.items():
		if prev_cells.get(key) != val:
			y, x = key
			idx, mark = val
			out.append(swatch_cell_seq(y, x, idx, mark))
	for key in prev_cells:
		if key not in new_cells:
			y, x = key
			out.append(f"\033[{y+1};{x+1}H\033[0m     ")
	prev_cells.clear()
	prev_cells.update(new_cells)
	return "".join(out)


def _next_non_gap(layout, from_row, target_col, direction):
	r = from_row + direction
	while 0 <= r < len(layout):
		if layout[r] is not GAP:
			row = layout[r]
			return row[min(target_col, len(row) - 1)]
		r += direction
	return None


## ---------- HSV mode rendering ----------

def truecolor_cell_seq(y, x, text, r, g, b, mark=False):
	"""Build a raw ANSI escape that paints (y,x) with a 24-bit background and
	`text`. If mark, also set a contrasting foreground (black/white per luma)
	so the cursor glyph stays visible on any bg. Coords are 0-based curses
	coords; ANSI's 1-based offset is added here."""
	seq = f"\033[{y+1};{x+1}H\033[48;2;{r};{g};{b}m"
	if mark:
		luma = 0.299 * r + 0.587 * g + 0.114 * b
		fr, fg, fb = (0, 0, 0) if luma > 130 else (255, 255, 255)
		seq += f"\033[38;2;{fr};{fg};{fb}m"
	seq += text
	seq += "\033[0m"
	return seq


_HSV_PLANE_CACHE = {}  ## (hue_idx, hue_steps, w, h) -> 2D nearest-xterm-256 index list
_HSV_PLANE_CACHE_CAP = 64  ## FIFO eviction so heavy zooming doesn't grow unbounded

def hsv_plane_indices(hue_idx, hue_steps, w, h):
	"""Cached: precomputed nearest-xterm-256 for every (sv_x, sv_y) cell at this
	hue/dim combo. ~w*h OKLab lookups per build; once cached, redraw is paint."""
	key = (hue_idx, hue_steps, w, h)
	plane = _HSV_PLANE_CACHE.get(key)
	if plane is not None:
		return plane
	hue_deg = hue_idx * (360.0 / hue_steps)
	plane = [[0] * w for _ in range(h)]
	for yy in range(h):
		v = 1 - yy / (h - 1) if h > 1 else 1
		for xx in range(w):
			s = xx / (w - 1) if w > 1 else 0
			r, g, b = hsv_to_rgb(hue_deg, s, v)
			plane[yy][xx] = rgb_to_xterm256(r, g, b)
	if len(_HSV_PLANE_CACHE) >= _HSV_PLANE_CACHE_CAP:
		_HSV_PLANE_CACHE.pop(next(iter(_HSV_PLANE_CACHE)))
	_HSV_PLANE_CACHE[key] = plane
	return plane


def hsv_at(hue_idx, sv_x, sv_y, hue_steps, w, h):
	"""Convert HSV grid coordinates to (h_deg, s, v, r, g, b)."""
	hue_deg = hue_idx * (360.0 / hue_steps)
	s = sv_x / (w - 1) if w > 1 else 0
	v = 1 - sv_y / (h - 1) if h > 1 else 1
	r, g, b = hsv_to_rgb(hue_deg, s, v)
	return hue_deg, s, v, r, g, b


def compute_truecolor_cells(hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
                            plane_scroll_y, plane_scroll_x,
                            plane_view_rows, plane_view_cols,
                            hue_scroll_x, hue_view_cells):
	"""Build the dict of visible truecolor cells: (screen_y, screen_x) ->
	(r, g, b, mark). Combines the hue strip and the SV plane.

	The caller diffs this against a previous-frame dict and emits ANSI escapes
	only for cells whose value changed — so cursor-only moves emit ~2 cells.

	hue_scroll_x and hue_view_cells are in cells-only space (the screen cols
	to the right of the HUE_LABEL); cells never spill into the label area."""
	cells = {}
	## Hue strip
	label_w = len(HUE_LABEL)
	for i in range(hue_steps):
		cells_x = i * HSV_CELL_W
		if cells_x < hue_scroll_x or cells_x + HSV_CELL_W > hue_scroll_x + hue_view_cells:
			continue
		hue_deg = i * (360.0 / hue_steps)
		r, g, b = hsv_to_rgb(hue_deg, 1.0, 1.0)
		is_cursor = (i == hue_idx)
		screen_y = HUE_SCREEN_Y
		screen_x = label_w + cells_x - hue_scroll_x
		cells[(screen_y, screen_x)] = (r, g, b, is_cursor)
	## SV plane
	cur_hue_deg = hue_idx * (360.0 / hue_steps)
	for yy in range(h_plane):
		if yy < plane_scroll_y or yy >= plane_scroll_y + plane_view_rows:
			continue
		for xx in range(w):
			cell_x_pad = xx * HSV_CELL_W
			if cell_x_pad < plane_scroll_x \
			        or cell_x_pad + HSV_CELL_W > plane_scroll_x + plane_view_cols:
				continue
			s = xx / (w - 1) if w > 1 else 0
			v = 1 - yy / (h_plane - 1) if h_plane > 1 else 1
			r, g, b = hsv_to_rgb(cur_hue_deg, s, v)
			is_cursor = (xx == sv_x and yy == sv_y and not hex_mode)
			screen_y = PLANE_SCREEN_TOP + (yy - plane_scroll_y)
			screen_x = HSV_PLANE_INDENT + (cell_x_pad - plane_scroll_x)
			cells[(screen_y, screen_x)] = (r, g, b, is_cursor)
	return cells


def emit_truecolor_diff(prev_cells, new_cells):
	"""Return concatenated ANSI escapes for cells whose value differs from
	the previous frame. Mutates prev_cells in place to become new_cells."""
	out = []
	for key, val in new_cells.items():
		if prev_cells.get(key) != val:
			y, x = key
			r, g, b, mark = val
			out.append(truecolor_cell_seq(y, x, "><" if mark else "  ",
			                              r, g, b, mark=mark))
	prev_cells.clear()
	prev_cells.update(new_cells)
	return "".join(out)


def indexed_cell_seq(y, x, text, idx, mark=False):
	"""Raw ANSI escape using the xterm-256 8-bit indexed colour. With mark,
	sets a contrast fg (xterm 16 black or 231 white per luma) so the cursor
	glyph stays visible on the banded backdrop."""
	seq = f"\033[{y+1};{x+1}H\033[48;5;{idx}m"
	if mark:
		r, g, b = xterm_to_rgb(idx)
		luma = 0.299 * r + 0.587 * g + 0.114 * b
		fg = 16 if luma > 130 else 231
		seq += f"\033[38;5;{fg}m"
	seq += text
	seq += "\033[0m"
	return seq


def compute_hsv_cells(hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
                      plane_scroll_y, plane_scroll_x,
                      plane_view_rows, plane_view_cols,
                      hue_scroll_x, hue_view_cells):
	"""Mirror of compute_truecolor_cells but the cell value is (xterm-256 idx,
	mark) — used for HSV mode where the visible colour is the banded match,
	not the underlying 24-bit RGB."""
	cells = {}
	label_w = len(HUE_LABEL)
	for i in range(hue_steps):
		cells_x = i * HSV_CELL_W
		if cells_x < hue_scroll_x or cells_x + HSV_CELL_W > hue_scroll_x + hue_view_cells:
			continue
		hue_deg = i * (360.0 / hue_steps)
		r, g, b = hsv_to_rgb(hue_deg, 1.0, 1.0)
		idx = rgb_to_xterm256(r, g, b)
		is_cursor = (i == hue_idx)
		screen_y = HUE_SCREEN_Y
		screen_x = label_w + cells_x - hue_scroll_x
		cells[(screen_y, screen_x)] = (idx, is_cursor)
	plane = hsv_plane_indices(hue_idx, hue_steps, w, h_plane)
	for yy in range(h_plane):
		if yy < plane_scroll_y or yy >= plane_scroll_y + plane_view_rows:
			continue
		for xx in range(w):
			cell_x_pad = xx * HSV_CELL_W
			if cell_x_pad < plane_scroll_x \
			        or cell_x_pad + HSV_CELL_W > plane_scroll_x + plane_view_cols:
				continue
			idx = plane[yy][xx]
			is_cursor = (xx == sv_x and yy == sv_y and not hex_mode)
			screen_y = PLANE_SCREEN_TOP + (yy - plane_scroll_y)
			screen_x = HSV_PLANE_INDENT + (cell_x_pad - plane_scroll_x)
			cells[(screen_y, screen_x)] = (idx, is_cursor)
	return cells


def emit_hsv_diff(prev_cells, new_cells):
	"""Indexed-color counterpart of emit_truecolor_diff."""
	out = []
	for key, val in new_cells.items():
		if prev_cells.get(key) != val:
			y, x = key
			idx, mark = val
			out.append(indexed_cell_seq(y, x, "><" if mark else "  ",
			                            idx, mark=mark))
	prev_cells.clear()
	prev_cells.update(new_cells)
	return "".join(out)


## ---------- Scroll / viewport ----------

SCROLL_HINT_STYLE = "\033[1;30;43m"  ## bold black on yellow — high contrast on any plane colour


def emit_scroll_hint(y, x, ch):
	return f"\033[{y+1};{x+1}H{SCROLL_HINT_STYLE}{ch}\033[0m"


def emit_plane_scroll_hints(plane_top, plane_indent, plane_rows, plane_cols,
                             scroll_y, scroll_x, total_h, total_w):
	"""Return ANSI escapes for <, >, ^, v hints overlaying the visible plane
	edges whenever there's content outside the viewport in that direction.
	Horizontal hints sit at the outer edge of the edge cell — the right margin
	keeps them clear of the screen border."""
	out = []
	if scroll_x > 0:
		y = plane_top + plane_rows // 2
		out.append(emit_scroll_hint(y, plane_indent, "<"))
	if scroll_x + plane_cols < total_w:
		y = plane_top + plane_rows // 2
		out.append(emit_scroll_hint(y, plane_indent + plane_cols - 1, ">"))
	if scroll_y > 0:
		x = plane_indent + plane_cols // 2
		out.append(emit_scroll_hint(plane_top, x, "^"))
	if scroll_y + plane_rows < total_h:
		x = plane_indent + plane_cols // 2
		y = plane_top + plane_rows - 1
		out.append(emit_scroll_hint(y, x, "v"))
	return "".join(out)


def emit_hue_scroll_hints(hue_y, hue_view_cells, scroll_x, total_cells,
                           label_w, right_screen_col):
	"""scroll_x and total_cells are in cells-only space (label excluded).
	< goes at the leftmost cell position (just past the label) so it
	anchors to the strip, not the label. > goes at right_screen_col."""
	out = []
	if scroll_x > 0:
		out.append(emit_scroll_hint(hue_y, label_w, "<"))
	if scroll_x + hue_view_cells < total_cells:
		out.append(emit_scroll_hint(hue_y, right_screen_col, ">"))
	return "".join(out)


def emit_swatch_scroll_hints(swatch_top, swatch_view_rows, scroll_y, total_h, mid_x):
	out = []
	if scroll_y > 0:
		out.append(emit_scroll_hint(swatch_top, mid_x, "^"))
	if scroll_y + swatch_view_rows < total_h:
		y = swatch_top + swatch_view_rows - 1
		out.append(emit_scroll_hint(y, mid_x, "v"))
	return "".join(out)


def compute_scroll(old, cursor, cell_size, view, total):
	"""Compute the scroll offset that keeps `cursor` inside a 25% margin of
	each viewport edge. `cursor` is the left/top edge of the cursor cell in
	plane coordinates, `cell_size` is the cell's width/height in those same
	units. Only re-scrolls when the cursor crosses into the margin — gives
	the user some visible context on the trailing side of a move and avoids
	a screen wipe on every keystroke. Centres the cursor on first frame
	(old is None)."""
	if total <= view:
		return 0
	max_scroll = max(0, total - view)
	if old is None:
		return max(0, min(max_scroll, cursor - view // 2))
	margin = max(1, view // 4)
	new = old
	if cursor - new < margin:
		new = cursor - margin
	elif cursor + cell_size - new > view - margin:
		new = cursor + cell_size - (view - margin)
	return max(0, min(max_scroll, new))


## ---------- Main picker loop ----------

def picker(layout, pos_map, initial_idx, preview_cmd, allow_hex,
           init_w, init_h, init_hue_steps, hue_steps_explicit, size_explicit):
	## Swatch state
	sel_idx = initial_idx if initial_idx in pos_map else 0
	intended_col = pos_map[sel_idx][1]
	num_buf = ""

	## HSV plane dims — mutable via zoom keys. w is bumped by
	## HSV_PLANE_STRETCH_CELLS so the plane's right edge aligns with the hue
	## strip's right edge (label takes that much extra width on the left).
	w, h_plane = init_w + HSV_PLANE_STRETCH_CELLS, init_h
	hue_steps = init_hue_steps

	## current_rgb is the underlying value. Tab does NOT touch it; movement does.
	current_rgb = xterm_to_rgb(sel_idx)
	hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)

	mode = "hsv"  ## default — banded full-spectrum picker
	hex_mode = False
	hex_buf = ""
	status_msg = ""

	## Logical dimensions of the hue ramp and the plane (in raw cell-cols).
	## Used to decide whether to scroll the visible window.
	## hue_total_cells = total width of the hue ramp in cells-only space (i.e.
	## not counting the "  Hue:" label). The label is fixed and never scrolls,
	## so all hue scrolling math is in cells-only coordinates.
	hue_total_cells = hue_steps * HSV_CELL_W
	plane_total_w = max(1, w * HSV_CELL_W)
	plane_total_h = max(1, h_plane)

	## Swatch total layout size — used to compute scroll bounds.
	rows_total = len(layout)
	cols_total = max(len(r) for r in layout if r is not GAP)
	swatch_total_h = rows_total + 1
	swatch_total_w = cols_total * (CELL_W + 1) + 4  # noqa: F841 (kept for future hscroll)

	## Movement key tuples — hoisted out of the loop. KEY_S* are our parsed
	## Shift-arrow constants; the capital-letter aliases are the portable
	## fallback for terminals that don't emit them.
	LEFT_1  = (KEY_LEFT,  ord('h'), ord('a'))
	LEFT_5  = (KEY_SLEFT, ord('H'), ord('A'))
	RIGHT_1 = (KEY_RIGHT, ord('l'), ord('d'))
	RIGHT_5 = (KEY_SRIGHT, ord('L'), ord('D'))
	UP_1    = (KEY_UP,    ord('k'), ord('w'))
	UP_5    = (KEY_SUP,   ord('K'), ord('W'))
	DOWN_1  = (KEY_DOWN,  ord('j'), ord('s'))
	DOWN_5  = (KEY_SDOWN, ord('J'), ord('S'))
	HUE_BACK_1    = (ord(','), ord('q'), ord('u'))
	HUE_BACK_5    = (ord('<'), ord('Q'), ord('U'))
	HUE_FORWARD_1 = (ord('.'), ord('e'), ord('o'))
	HUE_FORWARD_5 = (ord('>'), ord('E'), ord('O'))
	FIVE_X = set(LEFT_5 + RIGHT_5 + UP_5 + DOWN_5 + HUE_BACK_5 + HUE_FORWARD_5)

	def current_color_str():
		if hex_mode:
			if len(hex_buf) == 3:
				return "#" + "".join(c * 2 for c in hex_buf)
			if len(hex_buf) == 6:
				return "#" + hex_buf
			return None
		r, g, b = current_rgb
		if mode == "truecolor":
			return f"#{r:02x}{g:02x}{b:02x}"
		if mode == "swatch":
			return f"colour{sel_idx}"
		## hsv: quantised projection of current_rgb
		return f"colour{rgb_to_xterm256(r, g, b)}"

	## preview() is called from many key handlers — instead of firing the
	## preview command (a subprocess) on every keystroke we coalesce: handlers
	## set _preview_dirty, then flush_preview() runs once per drain cycle.
	## This keeps the picker snappy when keys are held (e.g. holding `,` for
	## hue change in truecolor mode, which would otherwise spawn one
	## `tmux set-window-option` per keystroke).
	_preview_dirty = False

	def preview():
		nonlocal _preview_dirty
		_preview_dirty = True

	def flush_preview():
		nonlocal _preview_dirty
		if _preview_dirty:
			run_preview(preview_cmd, current_color_str())
			_preview_dirty = False

	def set_value_from_hsv():
		"""Reads cursor (hue_idx, sv_x, sv_y) and writes current_rgb + sel_idx."""
		nonlocal current_rgb, sel_idx, intended_col
		_, _, _, r, g, b = hsv_at(hue_idx, sv_x, sv_y, hue_steps, w, h_plane)
		current_rgb = (r, g, b)
		sel_idx = rgb_to_xterm256(r, g, b)
		if sel_idx in pos_map:
			intended_col = pos_map[sel_idx][1]

	def set_value_from_swatch():
		"""Reads sel_idx and writes current_rgb + hue cursor."""
		nonlocal current_rgb, hue_idx, sv_x, sv_y
		current_rgb = xterm_to_rgb(sel_idx)
		hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)

	def commit_num_buf():
		nonlocal sel_idx, num_buf, intended_col
		if not num_buf:
			return
		n = int(num_buf)
		num_buf = ""
		if 0 <= n <= 255:
			sel_idx = n
			intended_col = pos_map[sel_idx][1]
			set_value_from_swatch()
			preview()

	## Truecolor overlay state: maps (screen_y, screen_x) -> (r, g, b, mark) for
	## what we last painted via raw ANSI. Used to diff each frame and emit only
	## the cells that changed. Reset whenever the screen layout changes (mode
	## switch, zoom, resize) so the next frame does a full repaint.
	cell_state = {}

	## Track scroll offsets across frames. When any of these change we wipe
	## the screen and force a full repaint — the diff-only update can leave
	## stale cells at the trailing edge of a scroll otherwise.
	prev_scroll = {"hue_x": None, "plane_x": None, "plane_y": None, "swatch_y": None}

	def apply_dims(new_w, new_h):
		"""Set plane to (new_w, new_h), recouple hue if not pinned, and resync
		the cursor from current_rgb. current_rgb is preserved."""
		nonlocal w, h_plane, hue_steps, hue_idx, sv_x, sv_y
		nonlocal hue_total_cells, plane_total_w, plane_total_h
		new_w = max(HSV_MIN_W, min(HSV_MAX_W, new_w))
		new_h = max(HSV_MIN_H, min(HSV_MAX_H, new_h))
		new_hue = hue_steps if hue_steps_explicit else max(HSV_MIN_W,
		                                                   min(HSV_MAX_W,
		                                                       new_w - HSV_PLANE_STRETCH_CELLS))
		if new_w == w and new_h == h_plane and new_hue == hue_steps:
			return
		w, h_plane, hue_steps = new_w, new_h, new_hue
		hue_idx, sv_x, sv_y = sync_hsv_from_rgb(*current_rgb, hue_steps, w, h_plane)
		hue_total_cells = hue_steps * HSV_CELL_W
		plane_total_w = max(1, w * HSV_CELL_W)
		plane_total_h = max(1, h_plane)
		cell_state.clear()  ## force full overlay repaint at new dims
		clear_screen()      ## wipe stale overlay paint at the previous dims
		preview()

	def apply_zoom(dw, dh):
		"""Value stays exact across zoom — cursor resyncs from current_rgb."""
		apply_dims(w + dw, h_plane + dh)

	def apply_auto_resize():
		"""Recompute plane dims from the live terminal size. Skipped when the
		user pinned a size via --size."""
		if size_explicit:
			return
		cols, rows = 80, 24
		try:
			sz = os.get_terminal_size()
			cols, rows = sz.columns, sz.lines
		except OSError:
			pass
		auto_w, auto_h = auto_plane_size(cols, rows)
		apply_dims(auto_w + HSV_PLANE_STRETCH_CELLS, auto_h)
		## Force a clean repaint on resize even if dims didn't change — the
		## terminal probably scrolled our content while we were inactive.
		cell_state.clear()
		clear_screen()

	def process_key(ch):
		"""Process a single key press. Returns None to keep going, or a
		(kind, value) tuple to exit the picker. Called from the input-drain
		loop so that holding a key processes the whole buffered run before
		we render again — keeps the picker responsive when keys queue up
		faster than we can paint."""
		nonlocal status_msg, hex_mode, hex_buf, mode, current_rgb
		nonlocal sel_idx, intended_col, hue_idx, sv_x, sv_y, num_buf

		status_msg = ""

		if ch == KEY_RESIZE:
			apply_auto_resize()
			return None

		## Hex sub-mode (active in both swatch and hsv modes)
		if hex_mode:
			if ch == 27:
				hex_mode = False
				hex_buf = ""
				preview()
				return None
			if ch in (10, 13):
				if len(hex_buf) in (3, 6):
					if len(hex_buf) == 3:
						hex_buf = "".join(c * 2 for c in hex_buf)
					return ("hex", "#" + hex_buf)
				status_msg = "need 3 or 6 hex digits"
				return None
			if ch in (127, 8):
				hex_buf = hex_buf[:-1]
				preview()
				return None
			if 32 <= ch < 127:
				c = chr(ch).lower()
				if c in "0123456789abcdef" and len(hex_buf) < 6:
					hex_buf += c
					if len(hex_buf) in (3, 6):
						h_str = hex_buf if len(hex_buf) == 6 else "".join(c2 * 2 for c2 in hex_buf)
						rr, gg, bb = hex_to_rgb("#" + h_str)
						if rr is not None:
							current_rgb = (rr, gg, bb)
							sel_idx = rgb_to_xterm256(rr, gg, bb)
							if sel_idx in pos_map:
								intended_col = pos_map[sel_idx][1]
							hue_idx, sv_x, sv_y = sync_hsv_from_rgb(rr, gg, bb,
							                                       hue_steps, w, h_plane)
						preview()
			return None

		## Common keys
		if ch == 27 or ch == 3:  ## Esc / Ctrl-C — both cancel. (Raw mode
			## suppresses the kernel's SIGINT translation, so Ctrl-C arrives
			## as byte 3 on stdin rather than as a signal.)
			return ("cancel", None)
		if ch == 9:  ## Tab — cycle hsv -> truecolor -> swatch -> hsv.
			if mode == "hsv":
				mode = "truecolor"
			elif mode == "truecolor":
				mode = "swatch"
			else:
				mode = "hsv"
			cell_state.clear()
			## Wipe the previous mode's paint before we repaint the next mode.
			clear_screen()
			preview()
			return None
		if ch == ord('#') and allow_hex:
			commit_num_buf()
			hex_mode = True
			hex_buf = ""
			return None
		if ch in (10, 13, ord(' ')):
			if mode == "swatch" and num_buf:
				commit_num_buf()
				return None
			if mode == "swatch":
				return ("num", sel_idx)
			r, g, b = current_rgb
			if mode == "truecolor":
				return ("hex", f"#{r:02x}{g:02x}{b:02x}")
			return ("num", rgb_to_xterm256(r, g, b))

		## Movement + zoom
		step = 5 if ch in FIVE_X else 1

		if mode == "swatch":
			if ch in LEFT_1 + LEFT_5:
				commit_num_buf()
				new_idx = max(0, sel_idx - step)
				if new_idx != sel_idx:
					sel_idx = new_idx
					intended_col = pos_map[sel_idx][1]
					set_value_from_swatch()
					preview()
			elif ch in RIGHT_1 + RIGHT_5:
				commit_num_buf()
				new_idx = min(255, sel_idx + step)
				if new_idx != sel_idx:
					sel_idx = new_idx
					intended_col = pos_map[sel_idx][1]
					set_value_from_swatch()
					preview()
			elif ch in UP_1 + UP_5:
				commit_num_buf()
				new_idx = sel_idx
				for _ in range(step):
					tmp = _next_non_gap(layout, pos_map[new_idx][0], intended_col, -1)
					if tmp is None:
						break
					new_idx = tmp
				if new_idx != sel_idx:
					sel_idx = new_idx
					set_value_from_swatch()
					preview()
			elif ch in DOWN_1 + DOWN_5:
				commit_num_buf()
				new_idx = sel_idx
				for _ in range(step):
					tmp = _next_non_gap(layout, pos_map[new_idx][0], intended_col, +1)
					if tmp is None:
						break
					new_idx = tmp
				if new_idx != sel_idx:
					sel_idx = new_idx
					set_value_from_swatch()
					preview()
			elif ch in (127, 8):
				num_buf = num_buf[:-1]
			elif 48 <= ch <= 57:
				digit = chr(ch)
				candidate = num_buf + digit
				if int(candidate) > 255:
					commit_num_buf()
					num_buf = digit
				else:
					num_buf = candidate
					if len(num_buf) == 3 or int(num_buf) * 10 > 255:
						commit_num_buf()
		else:
			## HSV / truecolor
			if ch in LEFT_1 + LEFT_5:
				sv_x = max(0, sv_x - step); set_value_from_hsv(); preview()
			elif ch in RIGHT_1 + RIGHT_5:
				sv_x = min(w - 1, sv_x + step); set_value_from_hsv(); preview()
			elif ch in UP_1 + UP_5:
				sv_y = max(0, sv_y - step); set_value_from_hsv(); preview()
			elif ch in DOWN_1 + DOWN_5:
				sv_y = min(h_plane - 1, sv_y + step); set_value_from_hsv(); preview()
			elif ch in HUE_BACK_1 + HUE_BACK_5:
				hue_idx = (hue_idx - step) % hue_steps; set_value_from_hsv(); preview()
			elif ch in HUE_FORWARD_1 + HUE_FORWARD_5:
				hue_idx = (hue_idx + step) % hue_steps; set_value_from_hsv(); preview()
			elif ch in (ord('+'), ord('=')):
				apply_zoom(+20, +10)
			elif ch in (ord('-'), ord('_')):
				apply_zoom(-20, -10)
		return None

	while True:
		term_h, term_w = get_terminal_size()
		## We never wipe the whole screen each frame — only when the layout
		## structurally changes (mode switch, zoom, resize). Lines we DO write
		## to (title/label/status/help) are right-padded so old content past
		## the new text is overwritten with spaces.
		title = "Select an xterm-256 / hex colour"
		write_at(0, max(0, (term_w - len(title)) // 2), title, bold=True)

		sel_str = current_color_str()
		cur_r, cur_g, cur_b = current_rgb
		if mode == "truecolor":
			extras = f"  (nearest: colour{rgb_to_xterm256(cur_r, cur_g, cur_b)})"
		elif mode == "hsv":
			extras = f"  (full: #{cur_r:02x}{cur_g:02x}{cur_b:02x})"
		else:
			extras = f"  (#{cur_r:02x}{cur_g:02x}{cur_b:02x})"
		next_mode = {"hsv": "truecolor", "truecolor": "swatch", "swatch": "hsv"}[mode]
		dims = f" {w}x{h_plane}" if mode != "swatch" else ""
		line1 = f" [{mode}{dims}]  Selection: {sel_str or '(typing...)'}{extras}"
		if num_buf:
			line1 += f"   typing: {num_buf}_"
		if hex_mode:
			line1 += f"   hex: #{hex_buf}{'_' * (6 - len(hex_buf))}"
		if status_msg:
			line1 += f"   ({status_msg})"
		if mode == "swatch":
			help_line = " arrows/hjkl/wasd move (Shift=5)  0-9 num" + \
			            ("  # hex" if allow_hex else "") + \
			            f"  Tab→{next_mode}  Enter accept  Esc cancel"
		else:
			help_line = " arrows/hjkl/wasd SV (Shift=5)  ,./qe/uo hue (Shift=5)  +/- zoom" + \
			            ("  # hex" if allow_hex else "") + \
			            f"  Tab→{next_mode}  Enter  Esc"

		swatch_top = 2  ## first row of the swatch grid

		row_room = max(0, term_w - 1)
		if mode != "swatch":
			## Hue strip label (cells are painted by compute_*_cells; this is
			## just the " Hue:" prefix at x=0 of HUE_SCREEN_Y).
			write_at(HUE_SCREEN_Y, 0, HUE_LABEL, bold=True)
			cur_hue_deg = hue_idx * (360.0 / hue_steps)
			label_text = f"Sat→   V↕   H={cur_hue_deg:5.1f}°"
			label_room = max(0, term_w - HSV_PLANE_INDENT - 1)
			write_at(LABEL_SCREEN_Y, HSV_PLANE_INDENT,
			         label_text[:label_room].ljust(label_room), dim=True)
		else:
			## Wipe the hue + label rows when we're in swatch mode.
			write_at(HUE_SCREEN_Y, 0, " " * row_room)
			write_at(LABEL_SCREEN_Y, 0, " " * row_room)

		write_at(term_h - 3, 0, line1[:row_room].ljust(row_room))
		write_at(term_h - 2, 0, help_line[:row_room].ljust(row_room), dim=True)

		if mode == "swatch":
			swatch_view_rows = max(1, term_h - swatch_top - 3)
			sel_row = pos_map[sel_idx][0]
			scroll_y = compute_scroll(prev_scroll["swatch_y"], sel_row, 1,
			                          swatch_view_rows, swatch_total_h)
			prev_scroll["swatch_y"] = scroll_y
			new_cells = compute_swatch_cells(
				layout, sel_idx, hex_mode, hex_buf,
				scroll_y, swatch_view_rows, term_w, swatch_top)
			diffs = emit_swatch_diff(cell_state, new_cells)
			if diffs:
				sys.stdout.write(diffs)
			sys.stdout.write(emit_swatch_scroll_hints(
				swatch_top, swatch_view_rows, scroll_y, swatch_total_h,
				max(0, term_w // 2)))
		else:
			## Compute scroll positions and visible window dimensions (shared
			## between hsv and truecolor branches). compute_scroll keeps the
			## cursor inside a 25% margin so a move within that margin doesn't
			## drag the viewport with it. Reserve HSV_RIGHT_MARGIN cols on the
			## right so the plane never reaches the screen edge when zoomed.
			label_w = len(HUE_LABEL)
			view_cols = max(1, term_w - HSV_RIGHT_MARGIN)
			## The hue ramp scrolls in cells-only space (excluding the fixed
			## label area). Cells must never appear at screen_x < label_w.
			hue_view_cells = max(1, view_cols - label_w)
			plane_view_rows = max(1, term_h - PLANE_SCREEN_TOP - 4)
			plane_view_cols = max(1, term_w - HSV_PLANE_INDENT - HSV_RIGHT_MARGIN)
			cursor_pad_y = sv_y
			cursor_pad_x = sv_x * HSV_CELL_W
			hue_scroll_x = compute_scroll(prev_scroll["hue_x"], hue_idx * HSV_CELL_W,
			                              HSV_CELL_W, hue_view_cells, hue_total_cells)
			plane_scroll_y = compute_scroll(prev_scroll["plane_y"], cursor_pad_y,
			                                1, plane_view_rows, plane_total_h)
			plane_scroll_x = compute_scroll(prev_scroll["plane_x"], cursor_pad_x,
			                                HSV_CELL_W, plane_view_cols, plane_total_w)
			## Snap horizontal scrolls to cell boundaries. Cells are 2 chars wide;
			## when scroll_x is mid-cell, the first visible cell shifts right by
			## 1 col, leaving the screen column where we drew < / > blank and
			## making the plane appear to "eat into" or "shed" a margin column
			## as the user scrolls. Snapping pins cell alignment.
			plane_scroll_x -= plane_scroll_x % HSV_CELL_W
			hue_scroll_x   -= hue_scroll_x   % HSV_CELL_W

			## Scroll changes shift every cell's pad_x mapping, so the diff
			## naturally re-emits every cell on the trailing edge — no need to
			## clear the screen. We do still pop the cells under each scroll
			## hint when scroll changes, so an indicator that just deactivated
			## doesn't ghost on top of a same-colour cell that the diff would
			## otherwise skip.
			scroll_changed = (
				prev_scroll["plane_x"] not in (None, plane_scroll_x) or
				prev_scroll["plane_y"] not in (None, plane_scroll_y) or
				prev_scroll["hue_x"]   not in (None, hue_scroll_x))
			if scroll_changed:
				mid_y = PLANE_SCREEN_TOP + plane_view_rows // 2
				mid_x = HSV_PLANE_INDENT + plane_view_cols // 2
				right_x = HSV_PLANE_INDENT + plane_view_cols - 1
				## Cells live at even screen_x; floor odd positions to find
				## the cell key that the indicator was overlaying.
				for (y, x) in [
					(mid_y, HSV_PLANE_INDENT),
					(mid_y, right_x - right_x % HSV_CELL_W),
					(PLANE_SCREEN_TOP, mid_x - mid_x % HSV_CELL_W),
					(PLANE_SCREEN_TOP + plane_view_rows - 1, mid_x - mid_x % HSV_CELL_W),
					(HUE_SCREEN_Y, 0),
					(HUE_SCREEN_Y, (view_cols - 1) - (view_cols - 1) % HSV_CELL_W),
				]:
					cell_state.pop((y, x), None)
			prev_scroll["plane_x"] = plane_scroll_x
			prev_scroll["plane_y"] = plane_scroll_y
			prev_scroll["hue_x"]   = hue_scroll_x

			if mode == "truecolor":
				new_cells = compute_truecolor_cells(
					hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
					plane_scroll_y, plane_scroll_x,
					plane_view_rows, plane_view_cols,
					hue_scroll_x, hue_view_cells)
				diffs = emit_truecolor_diff(cell_state, new_cells)
			else:
				new_cells = compute_hsv_cells(
					hue_idx, hue_steps, sv_x, sv_y, w, h_plane, hex_mode,
					plane_scroll_y, plane_scroll_x,
					plane_view_rows, plane_view_cols,
					hue_scroll_x, hue_view_cells)
				diffs = emit_hsv_diff(cell_state, new_cells)
			if diffs:
				sys.stdout.write(diffs)
			sys.stdout.write(emit_plane_scroll_hints(
				PLANE_SCREEN_TOP, HSV_PLANE_INDENT,
				plane_view_rows, plane_view_cols,
				plane_scroll_y, plane_scroll_x,
				plane_total_h, plane_total_w))
			sys.stdout.write(emit_hue_scroll_hints(
				HUE_SCREEN_Y, hue_view_cells, hue_scroll_x, hue_total_cells,
				label_w, view_cols - 1))

		sys.stdout.flush()

		## Wait for the first key (blocks), then drain any further keys from
		## the buffer non-blocking. We render once per drain cycle, so holding
		## a key down processes the whole buffered run before we paint again.
		try:
			ch = read_key(blocking=True)
		except KeyboardInterrupt:
			return ("cancel", None)
		if ch is None:
			continue
		result = process_key(ch)
		if result is not None:
			return result
		while True:
			try:
				ch = read_key(blocking=False)
			except KeyboardInterrupt:
				return ("cancel", None)
			if ch is None:
				break
			result = process_key(ch)
			if result is not None:
				return result

		## Coalesced preview: fire the preview-cmd once at the end of the
		## drain, with the final state, rather than once per buffered key.
		flush_preview()


## ---------- Sync helpers ----------

def sync_hsv_from_rgb(r, g, b, hue_steps, w, h):
	hh, s, v = rgb_to_hsv(r, g, b)
	hue_idx = round(hh / 360 * hue_steps) % hue_steps
	sv_x = max(0, min(w - 1, round(s * (w - 1))))
	sv_y = max(0, min(h - 1, round((1 - v) * (h - 1))))
	return hue_idx, sv_x, sv_y


## ---------- Main ----------

def _parse_size(spec):
	m = re.fullmatch(r"\s*(\d+)\s*x\s*(\d+)\s*", spec)
	if not m:
		raise argparse.ArgumentTypeError(
			f"--size must look like WxH (e.g. 80x50), got: {spec!r}")
	w, h = int(m.group(1)), int(m.group(2))
	if not (HSV_MIN_W <= w <= HSV_MAX_W and HSV_MIN_H <= h <= HSV_MAX_H):
		raise argparse.ArgumentTypeError(
			f"--size out of range: width [{HSV_MIN_W},{HSV_MAX_W}],"
			f" height [{HSV_MIN_H},{HSV_MAX_H}]")
	return (w, h)


def main():
	p = argparse.ArgumentParser(
		description="Interactive xterm-256 / hex colour picker.",
		formatter_class=argparse.RawDescriptionHelpFormatter,
		epilog=__doc__.split("\n", 2)[2])
	p.add_argument("--initial", default=None,
	               help='Starting colour (NN, colourNN, or #rrggbb).')
	p.add_argument("--preview-cmd", default=None,
	               help='Shell command; selected colour is appended on each move.')
	p.add_argument("--no-hex", action="store_true", help="Disable hex entry.")
	p.add_argument("--size", type=_parse_size, default=None, metavar="WxH",
	               help="HSV plane size. Default: 39x16. (24x8 minimum to reach all 240 colors in the cube.)")
	p.add_argument("--fullscreen", action="store_true",
	               help="Auto-fit HSV plane to the terminal size (overrides --size default).")
	p.add_argument("--hue-steps", type=int, default=None, metavar="N",
	               help="Cells in the hue ramp. Defaults to plane width. (Minimum 1530 needed for truecolor.)")
	args = p.parse_args()

	if not sys.stdin.isatty():
		try:
			sys.stdin = open("/dev/tty", "r")
		except OSError:
			print("select-term256-color: no TTY for input", file=sys.stderr)
			sys.exit(2)

	saved_stdout_fd = None
	if not sys.stdout.isatty():
		try:
			tty_fd = os.open("/dev/tty", os.O_WRONLY)
			saved_stdout_fd = os.dup(1)
			os.dup2(tty_fd, 1)
			os.close(tty_fd)
		except OSError:
			print("select-term256-color: cannot open /dev/tty", file=sys.stderr)
			sys.exit(2)

	layout = build_layout()
	pos_map = build_position_map(layout)
	kind, val = parse_initial(args.initial)
	initial_idx = val if kind == "num" else (hex_to_xterm256(val) if kind == "hex" else None)

	## Resolve plane dimensions. --size pins an exact size, --fullscreen
	## auto-fits and follows terminal resizes; otherwise default to 39x16
	## (sized for a standard 80x24 terminal) shrunk to whatever fits.
	if args.size is not None:
		init_w, init_h = args.size
		size_explicit = True
	elif args.fullscreen:
		init_w, init_h = auto_plane_size()
		size_explicit = False
	else:
		auto_w, auto_h = auto_plane_size()
		init_w, init_h = min(39, auto_w), min(16, auto_h)
		size_explicit = True
	hue_steps_explicit = args.hue_steps is not None
	if hue_steps_explicit:
		init_hue_steps = max(HSV_MIN_W, min(HSV_MAX_W, args.hue_steps))
	else:
		init_hue_steps = init_w

	try:
		enter_raw_screen()
		try:
			result = picker(layout, pos_map, initial_idx,
			                args.preview_cmd, not args.no_hex,
			                init_w, init_h, init_hue_steps,
			                hue_steps_explicit, size_explicit)
		finally:
			leave_raw_screen()
	finally:
		if saved_stdout_fd is not None:
			os.dup2(saved_stdout_fd, 1)
			os.close(saved_stdout_fd)

	rkind, rval = result
	if rkind == "cancel":
		if args.preview_cmd and args.initial:
			run_preview(args.preview_cmd, args.initial)
		sys.exit(1)
	if rkind == "num":
		print(f"colour{rval}")
	elif rkind == "hex":
		print(rval)


if __name__ == "__main__":
	main()
