# CLI
# ---------------------------------------------------------------------------

def resolve_columns(flag) -> int:
    if flag:
        return flag
    env = os.environ.get("COLUMNS")
    if env and env.isdigit() and int(env) > 0:
        return int(env)
    try:
        c = int(subprocess.check_output(["tput", "cols"]).decode().strip())
        if c > 0:
            return c
    except Exception:
        pass
    return 80


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="polish-markdown-tables",
        description=(
            "Reflow markdown pipe tables and text paragraphs to a target width. "
            "Tables can be padded, word-wrapped, and rendered with box-drawing "
            "or ASCII borders. Text paragraphs can be reflowed or unwrapped. "
            "An undo mode converts box-drawing tables back to plain markdown."
        ),
    )
    parser.add_argument("-C", "--columns", type=int, metavar="N",
                        help="target line width (default: $COLUMNS, tput cols, or 80)")
    parser.add_argument("-s", "--strategy", choices=sorted(STRATEGIES), default="smart",
                        help="column-balancing strategy (default: smart)")
    parser.add_argument("--beam-width", type=int, default=64,
                        help="beam width for the smart search (default: 64)")
    parser.add_argument("--min-col-width", type=int, default=2,
                        help="minimum column width (default: 2)")
    parser.add_argument("-u", "--undo", action="store_true",
                        help="convert box-drawing tables back to plain markdown "
                             "(combine with --wrap-text or --unwrap-text for prose)")
    parser.add_argument("--auto-undo", action=argparse.BooleanOptionalAction,
                        default=True,
                        help="before polishing, auto-convert any box-drawing "
                             "tables in the input back to plain markdown so they "
                             "can be re-formatted (default: on). Use "
                             "--no-auto-undo to leave box tables untouched.")

    presets = parser.add_argument_group("presets")
    presets.add_argument("--polish", action="store_true",
                         help="padding on, wrapping on, borders on (line); "
                              "breaks markdown but pretty (default)")
    presets.add_argument("--pad", action="store_true",
                         help="padding on, wrapping off, borders off; "
                              "produces legal markdown")

    toggles = parser.add_argument_group("table toggles (override preset defaults)")
    toggles.add_argument("--pad-table-columns", action=argparse.BooleanOptionalAction,
                         default=None,
                         help="force column padding on or off")
    toggles.add_argument("--wrap-table-cells", action=argparse.BooleanOptionalAction,
                         default=None,
                         help="force cell word-wrapping on or off (off = saturated widths)")

    parser.add_argument("-b", "--border",
                        choices=["none", "normal", "ascii", "line"],
                        default=None,
                        help="border style when borders are on: none/normal "
                             "(GFM pipe table), ascii (+,-,|), line (box-drawing). "
                             "Default from preset (line for --polish, none for --pad)")
    parser.add_argument("--color", choices=["auto", "always", "never"], default="auto",
                        help="ANSI color mode (bold header, dim borders/delimiter). "
                             "auto: color iff stdout is a TTY, honoring NO_COLOR / "
                             "CLICOLOR / CLICOLOR_FORCE")

    text_group = parser.add_mutually_exclusive_group()
    text_group.add_argument("--wrap-text", action="store_true",
                            help="reflow text paragraphs to target width "
                                 "(GFM paragraph rules; box tables are left intact)")
    text_group.add_argument("--unwrap-text", action="store_true",
                            help="join text paragraph lines into single lines "
                                 "(box tables are left intact)")

    parser.add_argument("--debug", action="store_true",
                        help="print per-table widths/heights for all strategies to stderr")
    parser.add_argument("file", nargs="?", help="markdown file (default: stdin)")
    args = parser.parse_args(argv)

    if args.beam_width < 1:
        parser.error("--beam-width must be >= 1")
    if args.min_col_width < 1:
        parser.error("--min-col-width must be >= 1")

    if args.polish and args.pad:
        # polish is a superset; treat as --polish
        pass

    if args.polish:
        pad, wrap, border_default = True, True, "line"
    elif args.pad:
        pad, wrap, border_default = True, False, "none"
    else:
        pad, wrap, border_default = True, True, "line"

    if args.pad_table_columns is not None:
        pad = args.pad_table_columns
    if args.wrap_table_cells is not None:
        wrap = args.wrap_table_cells
    border = args.border if args.border is not None else border_default
    if border == "normal":
        border = "none"

    target = resolve_columns(args.columns)
    if args.file:
        with open(args.file, "r") as f:
            text = f.read()
    else:
        text = sys.stdin.read()

    color = resolve_color(args.color)
    if args.undo:
        result = process_undo(text, target, args.wrap_text, args.unwrap_text)
    else:
        if args.auto_undo:
            # Pre-process: convert any box tables back to plain markdown so the
            # normal table detection can re-polish them.
            text = process_undo(text, target, False, False)
        result = process(text, target, args.strategy, args.beam_width,
                         args.min_col_width, args.debug, border, color,
                         pad, wrap, args.wrap_text, args.unwrap_text)
    sys.stdout.write(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())